@model GMS.Web.Models.Entities.Grievance

@{
    ViewData["Title"] = $"Ticket {Model.TicketNumber}";
    Layout = "_StudentLayout";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-sm btn-gms-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
    </a>
</div>

<!-- Ticket header details -->
<div class="card shadow-sm border-0 rounded-3 mb-4 bg-white">
    <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
        <div>
            <span class="badge bg-primary mb-1">TICKET DETAIL</span>
            <h4 class="mb-0 fw-bold">@Model.TicketNumber</h4>
        </div>
        <div>
            @if (Model.Status == GMS.Web.Models.Entities.GrievanceStatus.Open)
            {
                <span class="fs-6 badge-status badge-status-open">Open</span>
            }
            else if (Model.Status == GMS.Web.Models.Entities.GrievanceStatus.InProgress)
            {
                <span class="fs-6 badge-status badge-status-progress">InProgress</span>
            }
            else
            {
                <span class="fs-6 badge-status badge-status-resolved">Resolved</span>
            }
        </div>
    </div>
    
    <div class="card-body p-4">
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <span class="text-muted small d-block">CATEGORY</span>
                <span class="fw-semibold">@Model.Category?.Name</span>
            </div>
            <div class="col-6 col-md-3">
                <span class="text-muted small d-block">DEPARTMENT ASSIGNED</span>
                <span class="fw-semibold">@Model.Department?.Name</span>
            </div>
            <div class="col-6 col-md-3">
                <span class="text-muted small d-block">INCIDENT DATE</span>
                <span class="fw-semibold">@Model.IncidentDate.ToString("D")</span>
            </div>
            <div class="col-6 col-md-3">
                <span class="text-muted small d-block">SUBMITTED ON</span>
                <span class="fw-semibold">@Model.SubmittedAt.ToString("g")</span>
            </div>
        </div>

        <hr class="my-4" />

        <div class="mb-4">
            <h5 class="fw-bold mb-2 text-dark">Subject Title</h5>
            <p class="fs-5 fw-semibold text-dark">@Model.Title</p>
        </div>

        <div class="mb-4">
            <h5 class="fw-bold mb-2 text-dark">Full Description</h5>
            <div class="p-3 bg-light rounded border text-secondary" style="white-space: pre-wrap; line-height: 1.6;">@Model.Description</div>
        </div>

        <!-- Evidence attachments -->
        <div class="mb-4">
            <h5 class="fw-bold mb-2 text-dark"><i class="bi bi-paperclip me-1"></i> Evidence Attachments</h5>
            @if (Model.Attachments.Any())
            {
                <div class="row g-2">
                    @foreach (var file in Model.Attachments)
                    {
                        <div class="col-md-6">
                            <div class="p-2 border rounded-3 d-flex justify-content-between align-items-center bg-light">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-file-earmark-text text-primary fs-4 me-2"></i>
                                    <div>
                                        <span class="d-block text-dark fw-medium text-truncate" style="max-width: 200px;" title="@file.FileName">@file.FileName</span>
                                        <small class="text-secondary">@Math.Round((double)file.FileSize / 1024, 1) KB</small>
                                    </div>
                                </div>
                                <a asp-action="DownloadAttachment" asp-route-id="@file.Id" class="btn btn-sm btn-primary px-3">
                                    <i class="bi bi-download"></i> Download
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="small text-secondary italic mb-0">No attachments uploaded for this ticket.</p>
            }
        </div>

        <!-- Resolution Notes -->
        @if (Model.Status == GMS.Web.Models.Entities.GrievanceStatus.Resolved)
        {
            <div class="p-3 border border-success bg-success bg-opacity-10 rounded-3 mb-4">
                <h5 class="fw-bold text-success-emphasis mb-1"><i class="bi bi-check-circle-fill me-2"></i> Resolution Statement</h5>
                <p class="text-secondary mb-0" style="white-space: pre-wrap;">@Model.ResolutionNotes</p>
            </div>
        }
    </div>
</div>

<!-- History Log -->
<div class="card shadow-sm border-0 rounded-3 bg-white">
    <div class="card-header bg-light py-3">
        <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-clock-history me-2 text-primary"></i> Status & Audit History</h5>
    </div>
    <div class="card-body p-4">
        @if (Model.StatusHistory.Any())
        {
            <div class="position-relative border-start border-2 border-light ps-4">
                @foreach (var history in Model.StatusHistory.OrderByDescending(sh => sh.ChangedAt))
                {
                    <div class="mb-4 position-relative">
                        <!-- Timeline circle node -->
                        <div class="position-absolute" style="left: -33px; top: 0px; background: white; padding: 2px;">
                            @if (history.NewStatus == GMS.Web.Models.Entities.GrievanceStatus.Resolved)
                            {
                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            }
                            else if (history.NewStatus == GMS.Web.Models.Entities.GrievanceStatus.InProgress)
                            {
                                <i class="bi bi-hourglass-split text-warning fs-5"></i>
                            }
                            else
                            {
                                <i class="bi bi-circle-fill text-primary fs-5"></i>
                            }
                        </div>
                        <div>
                            <span class="small text-muted d-block">@history.ChangedAt.ToString("f")</span>
                            <strong class="text-dark">Status set to: @history.NewStatus.ToString()</strong>
                            @if (!string.IsNullOrEmpty(history.Notes))
                            {
                                <p class="text-secondary small mt-1 mb-0 italic">Note: "@history.Notes"</p>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="small text-secondary italic mb-0">No history logged yet. Ticket is awaiting initial review.</p>
        }
    </div>
</div>
