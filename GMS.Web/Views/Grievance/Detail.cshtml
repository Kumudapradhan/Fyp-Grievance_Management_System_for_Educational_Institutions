@model GMS.Web.Models.Entities.Grievance

@{
    ViewData["Title"] = "Complaint Details";
    ViewData["ActiveNav"] = "MyGrievances";
    Layout = "_StudentLayout";

    // ── Safe null-guarded timeline calculation ──────────────────────
    var history = Model.StatusHistory?.OrderBy(x => x.ChangedAt).ToList()
                  ?? new List<GMS.Web.Models.Entities.GrievanceStatusHistory>();

    DateTime? submittedAt = Model.SubmittedAt;
    DateTime? assignedAt  = null;
    DateTime? inProgAt    = null;
    DateTime? resolvedAt  = null;

    foreach (var h in history)
    {
        switch (h.NewStatus)
        {
            case GMS.Web.Models.Entities.GrievanceStatus.InProgress:
                assignedAt ??= h.ChangedAt;
                inProgAt    = h.ChangedAt;
                break;
            case GMS.Web.Models.Entities.GrievanceStatus.Resolved:
                assignedAt ??= h.ChangedAt;
                inProgAt   ??= h.ChangedAt;
                resolvedAt  = h.ChangedAt;
                break;
        }
    }

    // If assigned staff exists but no history entry, use submitted date as fallback
    if (assignedAt == null && !string.IsNullOrEmpty(Model.AssignedStaffUserId))
        assignedAt = history.FirstOrDefault()?.ChangedAt ?? submittedAt;

    bool stepAssigned = assignedAt != null;
    bool stepInProg   = inProgAt   != null
                     || Model.Status == GMS.Web.Models.Entities.GrievanceStatus.InProgress
                     || Model.Status == GMS.Web.Models.Entities.GrievanceStatus.Resolved;
    bool stepResolved = Model.Status == GMS.Web.Models.Entities.GrievanceStatus.Resolved;

    string barWidth = stepResolved ? "84%" : stepInProg ? "56%" : stepAssigned ? "28%" : "0%";

    // initials helper
    string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 1
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
            : parts[0][0].ToString().ToUpper();
    }
}

<style>
/* ─── page wrapper ─── */
.dp { display:flex; flex-direction:column; gap:1.25rem; max-width:1100px; }

/* ─── CARD base ─── */
.dp-card {
    background:#fff;
    border:1px solid #e2e8f0;
    border-radius:14px;
    padding:1.6rem 2rem;
}

/* ─── Header card ─── */
.dp-badges { display:flex; align-items:center; gap:.55rem; flex-wrap:wrap; margin-bottom:.55rem; }
.dp-ticket { font-size:.8rem; font-weight:800; color:#2563eb; letter-spacing:.06em; }
.dp-title  { font-size:1.35rem; font-weight:800; color:#0f172a; line-height:1.25; margin-bottom:.35rem; }
.dp-sub    { font-size:.82rem; color:#94a3b8; }

/* status pills */
.sp { display:inline-flex; align-items:center; gap:.3rem; padding:.25rem .7rem; border-radius:999px; font-size:.75rem; font-weight:600; }
.sp::before { content:''; width:6px; height:6px; border-radius:50%; display:inline-block; }
.sp-open     { background:#eff6ff; color:#1d4ed8; } .sp-open::before     { background:#1d4ed8; }
.sp-progress { background:#fffbeb; color:#b45309; } .sp-progress::before { background:#b45309; }
.sp-resolved { background:#f0fdf4; color:#15803d; } .sp-resolved::before { background:#15803d; }
.sp-overdue  { background:#fef2f2; color:#b91c1c; } .sp-overdue::before  { background:#b91c1c; }

/* priority badge */
.prb { display:inline-block; padding:.2rem .55rem; border-radius:6px; font-size:.72rem; font-weight:700; }
.prb-low    { background:#dcfce7; color:#166534; }
.prb-medium { background:#fef3c7; color:#92400e; }
.prb-high   { background:#fee2e2; color:#991b1b; }

/* ─── Timeline card ─── */
.tl-title { font-size:.95rem; font-weight:700; color:#0f172a; margin-bottom:1.8rem; }

.stepper { position:relative; display:flex; justify-content:space-between; }
/* grey track */
.stepper::before {
    content:''; position:absolute;
    top:18px; left:12.5%; right:12.5%;
    height:2px; background:#e2e8f0; z-index:0;
}
/* blue bar */
.tl-progress {
    position:absolute; top:18px; left:12.5%;
    height:2px; background:#2563eb; z-index:1;
    width: @barWidth;
    transition:width .4s ease;
}
.tl-step { flex:1; display:flex; flex-direction:column; align-items:center; position:relative; z-index:2; }

.tl-circle {
    width:38px; height:38px; border-radius:50%;
    background:#fff; border:2.5px solid #cbd5e1;
    display:flex; align-items:center; justify-content:center;
    font-size:1rem; color:#94a3b8;
    transition:all .3s;
}
/* pending: grey dot inside */
.tl-step.pend .tl-circle::after {
    content:''; display:block; width:10px; height:10px; border-radius:50%; background:#e2e8f0;
}
/* done: filled blue */
.tl-step.done .tl-circle {
    background:#2563eb; border-color:#2563eb; color:#fff;
    box-shadow:0 0 0 5px rgba(37,99,235,.12);
}

.tl-name { font-size:.8rem; font-weight:600; color:#64748b; margin-top:.6rem; }
.tl-step.done .tl-name { color:#0f172a; }
.tl-date { font-size:.7rem; color:#94a3b8; margin-top:.1rem; text-align:center; min-height:1rem; }

/* ─── Two-col grid ─── */
.dp-grid { display:grid; grid-template-columns:1.6fr 1fr; gap:1.25rem; align-items:start; }
@@media(max-width:860px){ .dp-grid { grid-template-columns:1fr; } }

/* ─── Left: Complaint Details ─── */
.cd-label { font-size:.95rem; font-weight:700; color:#0f172a; margin-bottom:.9rem; }
.cd-desc  { font-size:.875rem; color:#64748b; line-height:1.75; margin-bottom:1.6rem; }

.meta-rows { border-top:1px solid #f1f5f9; }
.meta-row  { display:flex; justify-content:space-between; align-items:center; padding:.55rem 0; border-bottom:1px solid #f1f5f9; }
.meta-key  { font-size:.82rem; color:#94a3b8; font-weight:500; }
.meta-val  { font-size:.82rem; color:#1e3a8a; font-weight:600; text-align:right; }

.ev-title { font-size:.875rem; font-weight:700; color:#0f172a; margin:1.4rem 0 .6rem; }
.ev-list  { display:flex; flex-wrap:wrap; gap:.5rem; }
.ev-pill  {
    display:inline-flex; align-items:center; gap:.35rem;
    border:1.5px solid #e2e8f0; border-radius:999px;
    padding:.28rem .7rem; font-size:.78rem; font-weight:500; color:#475569;
    text-decoration:none; background:#fff; transition:border-color .15s,color .15s;
}
.ev-pill:hover { border-color:#2563eb; color:#2563eb; }

/* ─── Right column ─── */
.dp-right { display:flex; flex-direction:column; gap:1.25rem; }

/* Resolution Notes */
.rn-card { background:#eff6ff; border:1px solid #bfdbfe; border-radius:14px; padding:1.35rem 1.5rem; }
.rn-label { font-size:.95rem; font-weight:700; color:#1e3a8a; margin-bottom:.45rem; }
.rn-text  { font-size:.83rem; color:#3b82f6; line-height:1.65; font-style:italic; }
.rn-text.has-notes { color:#1e3a8a; font-style:normal; }

/* Comments */
.cm-card { background:#fff; border:1px solid #e2e8f0; border-radius:14px; overflow:hidden; }
.cm-head { padding:1rem 1.5rem .8rem; font-size:.95rem; font-weight:700; color:#0f172a; border-bottom:1px solid #f1f5f9; }
.cm-list { padding:1rem 1.5rem; display:flex; flex-direction:column; gap:1rem; max-height:300px; overflow-y:auto; }
.cm-item { display:flex; align-items:flex-start; gap:.65rem; }
.cm-av {
    width:34px; height:34px; border-radius:50%; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
    font-size:.72rem; font-weight:800; color:#fff;
}
.cm-av-s { background:#2563eb; }
.cm-av-a { background:#0d9488; }
.cm-bub  { flex:1; }
.cm-who  { display:flex; align-items:baseline; gap:.35rem; margin-bottom:.15rem; }
.cm-name { font-size:.81rem; font-weight:700; color:#0f172a; }
.cm-when { font-size:.69rem; color:#94a3b8; }
.cm-txt  { font-size:.82rem; color:#475569; line-height:1.55; }
.cm-empty { text-align:center; padding:1.75rem; color:#94a3b8; font-size:.83rem; }
.cm-empty i { font-size:1.5rem; display:block; margin-bottom:.4rem; }

/* Comment form */
.cm-form { padding:.75rem 1.25rem; border-top:1px solid #f1f5f9; }
.cm-row  { display:flex; align-items:center; gap:.5rem; }
.cm-inp  {
    flex:1; padding:.5rem 1rem; border:1.5px solid #e2e8f0; border-radius:20px;
    font-size:.83rem; font-family:'Inter',sans-serif; color:#0f172a; outline:none;
    transition:border-color .2s;
}
.cm-inp:focus { border-color:#2563eb; }
.cm-inp::placeholder { color:#94a3b8; }
.cm-send {
    width:36px; height:36px; border-radius:50%; flex-shrink:0;
    background:#2563eb; color:#fff; border:none; cursor:pointer;
    display:flex; align-items:center; justify-content:center; font-size:.85rem;
    transition:background .2s;
}
.cm-send:hover { background:#1d4ed8; }
</style>

<div class="dp">

    
    <div class="dp-card">
        <div class="dp-badges">
            <span class="dp-ticket">@Model.TicketNumber</span>

            @{
                var isOverdue = Model.IsOverdue;
                var st = Model.Status;
            }
            @if (isOverdue)
            { <span class="sp sp-overdue">Overdue</span> }
            else if (st == GMS.Web.Models.Entities.GrievanceStatus.Open)
            { <span class="sp sp-open">Open</span> }
            else if (st == GMS.Web.Models.Entities.GrievanceStatus.InProgress)
            { <span class="sp sp-progress">In Progress</span> }
            else
            { <span class="sp sp-resolved">Resolved</span> }

            @if (Model.Priority == GMS.Web.Models.Entities.GrievancePriority.High)
            { <span class="prb prb-high">High</span> }
            else if (Model.Priority == GMS.Web.Models.Entities.GrievancePriority.Medium)
            { <span class="prb prb-medium">Medium</span> }
            else
            { <span class="prb prb-low">Normal</span> }
        </div>
        <div class="dp-title">@Model.Title</div>
        <div class="dp-sub">
            Submitted on @Model.SubmittedAt.ToString("yyyy-MM-dd")
            &middot; Department: @(Model.Department?.Name ?? "—")
        </div>
    </div>

    
    <div class="dp-card">
        <div class="tl-title">Timeline</div>
        <div class="stepper">
            <div class="tl-progress"></div>

            
            <div class="tl-step done">
                <div class="tl-circle"><i class="bi bi-check-lg"></i></div>
                <div class="tl-name">Submitted</div>
                <div class="tl-date">@submittedAt?.ToString("MMM d, yyyy HH:mm")</div>
            </div>

            
            <div class="tl-step @(stepAssigned ? "done" : "pend")">
                <div class="tl-circle">
                    @if (stepAssigned) { <i class="bi bi-check-lg"></i> }
                </div>
                <div class="tl-name">Assigned</div>
                <div class="tl-date">@(assignedAt?.ToString("MMM d, yyyy HH:mm") ?? "—")</div>
            </div>

            
            <div class="tl-step @(stepInProg ? "done" : "pend")">
                <div class="tl-circle">
                    @if (stepInProg) { <i class="bi bi-check-lg"></i> }
                </div>
                <div class="tl-name">In Progress</div>
                <div class="tl-date">@(inProgAt?.ToString("MMM d, yyyy HH:mm") ?? "—")</div>
            </div>

            
            <div class="tl-step @(stepResolved ? "done" : "pend")">
                <div class="tl-circle">
                    @if (stepResolved) { <i class="bi bi-check-lg"></i> }
                </div>
                <div class="tl-name">Resolved</div>
                <div class="tl-date">@(resolvedAt?.ToString("MMM d, yyyy HH:mm") ?? "—")</div>
            </div>
        </div>
    </div>

    
    <div class="dp-grid">

        
        <div class="dp-card">
            <div class="cd-label">Complaint Details</div>
            <p class="cd-desc">@Model.Description</p>

            <div class="meta-rows">
                <div class="meta-row">
                    <span class="meta-key">Assigned To</span>
                    <span class="meta-val">@(Model.AssignedStaffUser?.FullName ?? "Pending")</span>
                </div>
                <div class="meta-row">
                    <span class="meta-key">Department</span>
                    <span class="meta-val">@(Model.Department?.Name ?? "—")</span>
                </div>
                <div class="meta-row">
                    <span class="meta-key">Category</span>
                    <span class="meta-val">@(Model.Category?.Name ?? "—")</span>
                </div>
                @if (Model.IncidentDate != default(DateTime))
                {
                    <div class="meta-row">
                        <span class="meta-key">Incident Date</span>
                        <span class="meta-val">@Model.IncidentDate.ToString("yyyy-MM-dd")</span>
                    </div>
                }
            </div>

            @{
                var attachments = Model.Attachments?.ToList() ?? new List<GMS.Web.Models.Entities.GrievanceAttachment>();
            }
            @if (attachments.Any())
            {
                <div class="ev-title">Evidence</div>
                <div class="ev-list">
                    @foreach (var att in attachments)
                    {
                        <a asp-action="DownloadAttachment" asp-route-id="@att.Id" class="ev-pill">
                            <i class="bi bi-paperclip"></i>@att.FileName
                        </a>
                    }
                </div>
            }
        </div>

        
        <div class="dp-right">

            
            <div class="rn-card">
                <div class="rn-label">Resolution Notes</div>
                @if (Model.Status == GMS.Web.Models.Entities.GrievanceStatus.Resolved
                     && !string.IsNullOrWhiteSpace(Model.ResolutionNotes))
                {
                    <div class="rn-text has-notes">@Model.ResolutionNotes</div>
                }
                else
                {
                    <div class="rn-text">No resolution notes yet. The assigned officer will update this section.</div>
                }
            </div>

            
            <div class="cm-card">
                <div class="cm-head">Comments</div>

                @{
                    var comments = Model.Comments?.OrderBy(c => c.CreatedAt).ToList()
                                   ?? new List<GMS.Web.Models.Entities.Comment>();
                }

                <div class="cm-list">
                    @if (comments.Any())
                    {
                        @foreach (var cmt in comments)
                        {
                            var isStaff = cmt.User?.Email != null
                                       && (cmt.User.Email.Contains("staff", StringComparison.OrdinalIgnoreCase)
                                          || cmt.User.Email.Contains("admin", StringComparison.OrdinalIgnoreCase));
                            var avCls  = isStaff ? "cm-av-a" : "cm-av-s";
                            var author = cmt.User?.FullName ?? "Unknown";

                            <div class="cm-item">
                                <div class="cm-av @avCls">@Initials(author)</div>
                                <div class="cm-bub">
                                    <div class="cm-who">
                                        <span class="cm-name">@author</span>
                                        <span class="cm-when">&bull; @cmt.CreatedAt.ToString("MMM d")</span>
                                    </div>
                                    <div class="cm-txt">@cmt.Content</div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="cm-empty">
                            <i class="bi bi-chat-dots"></i>
                            No comments yet. Start the conversation.
                        </div>
                    }
                </div>

                <div class="cm-form">
                    <form asp-action="AddComment" method="post" class="cm-row">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="grievanceId" value="@Model.Id" />
                        <input type="text" name="content" class="cm-inp"
                               placeholder="Add a comment..." required autocomplete="off" />
                        <button type="submit" class="cm-send">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>

</div>
