@model GMS.Web.Models.ViewModels.StaffDashboardViewModel

@{
    ViewData["Title"] = "Staff Queue";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<!-- Welcome Section for Department Officer -->
<div class="card shadow-sm border-0 rounded-3 p-4 mb-4 bg-white">
    <div class="d-flex align-items-center">
        <div class="p-3 bg-primary bg-opacity-10 rounded-3 me-3 text-primary fs-1">
            <i class="bi bi-briefcase-fill"></i>
        </div>
        <div>
            <h3 class="fw-bold mb-1 text-dark">@Model.DepartmentName Queue</h3>
            <p class="text-secondary mb-0">Department Officer Portal | Description: @Model.DepartmentDescription</p>
        </div>
    </div>
</div>

<!-- KPI Cards Row -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md">
        <div class="metric-card h-100 border-0 shadow-none py-2 text-center border-end">
            <span class="metric-title text-uppercase font-monospace text-secondary fs-7">My Assigned</span>
            <span class="metric-value fs-3 fw-bold text-primary">@Model.AssignedCount</span>
        </div>
    </div>
    <div class="col-6 col-md">
        <div class="metric-card h-100 border-0 shadow-none py-2 text-center border-end">
            <span class="metric-title text-uppercase font-monospace text-secondary fs-7">Unassigned Pending</span>
            <span class="metric-value fs-3 fw-bold text-warning">@Model.PendingCount</span>
        </div>
    </div>
    <div class="col-6 col-md">
        <div class="metric-card h-100 border-0 shadow-none py-2 text-center border-end">
            <span class="metric-title text-uppercase font-monospace text-secondary fs-7">In Progress</span>
            <span class="metric-value fs-3 fw-bold text-info">@Model.InProgressCount</span>
        </div>
    </div>
    <div class="col-6 col-md">
        <div class="metric-card h-100 border-0 shadow-none py-2 text-center border-end">
            <span class="metric-title text-uppercase font-monospace text-secondary fs-7">Resolved Today</span>
            <span class="metric-value fs-3 fw-bold text-success">@Model.ResolvedTodayCount</span>
        </div>
    </div>
    <div class="col col-md text-center">
        <div class="metric-card h-100 border-0 shadow-none py-2">
            <span class="metric-title text-uppercase font-monospace text-secondary fs-7">Overdue Alerts</span>
            <span class="metric-value fs-3 fw-bold text-danger">@Model.OverdueCount</span>
        </div>
    </div>
</div>

<!-- Chart.js Visualization Grid -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-3 bg-white h-100">
            <div class="card-header bg-light py-3">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-pie-chart-fill me-2 text-primary"></i> Assigned vs Completed</h6>
            </div>
            <div class="card-body d-flex justify-content-center align-items-center" style="position: relative; height:240px;">
                <canvas id="assignedVsCompletedChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-3 bg-white h-100">
            <div class="card-header bg-light py-3">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-bar-chart-fill me-2 text-success"></i> Monthly Workload (Resolutions)</h6>
            </div>
            <div class="card-body d-flex justify-content-center align-items-center" style="position: relative; height:240px;">
                <canvas id="workloadChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Bottom Layout Splitted Panels -->
<div class="row g-3">
    <!-- Left Column: Routed Grievances filters & table -->
    <div class="col-lg-8">
        <!-- Filters section -->
        <div class="card shadow-sm border-0 rounded-3 bg-white mb-4">
            <div class="card-header bg-light py-3">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-funnel-fill me-2 text-primary"></i> Filter Department Queue</h6>
            </div>
            <div class="card-body p-3">
                <form asp-action="Index" method="get">
                    <div class="row g-3 align-items-end">
                        <div class="col-sm-6 col-md-2">
                            <label class="form-label small fw-semibold">Status</label>
                            <select name="status" class="form-select form-select-sm form-control-gms">
                                <option value="">-- All Statuses --</option>
                                @foreach (var val in Enum.GetValues(typeof(GMS.Web.Models.Entities.GrievanceStatus)))
                                {
                                    var selected = Model.SelectedStatus?.ToString() == val.ToString() ? "selected" : "";
                                    <!option value="@val" @selected>@val.ToString()</!option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-6 col-md-2">
                            <label class="form-label small fw-semibold">Priority</label>
                            <select name="priority" class="form-select form-select-sm form-control-gms">
                                <option value="">-- All Priorities --</option>
                                @foreach (var val in Enum.GetValues(typeof(GMS.Web.Models.Entities.GrievancePriority)))
                                {
                                    var selected = Model.SelectedPriority?.ToString() == val.ToString() ? "selected" : "";
                                    <!option value="@val" @selected>@val.ToString()</!option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <label class="form-label small fw-semibold d-block">Assignment</label>
                            <div class="form-check form-switch form-control-sm pt-1">
                                <input class="form-check-input" type="checkbox" name="myAssigned" id="myAssignedSwitch" value="true" @(Model.MyAssignedOnly ? "checked" : "") />
                                <label class="form-check-label small fw-medium" for="myAssignedSwitch">My Assigned Only</label>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <label class="form-label small fw-semibold">Keyword Search</label>
                            <input type="text" name="search" class="form-control form-control-sm form-control-gms" placeholder="Search..." value="@Model.SearchQuery" />
                        </div>
                        <div class="col-md-2 d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-gms-primary btn-sm flex-grow-1">
                                <i class="bi bi-filter"></i> Apply
                            </button>
                            <a asp-action="Index" class="btn btn-gms-secondary btn-sm flex-grow-1 text-center">
                                Reset
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Grievances Table -->
        <div class="card shadow-sm border-0 rounded-3 bg-white">
            <div class="card-header bg-light py-3">
                <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-list-check me-2 text-primary"></i> Routed Grievances</h5>
            </div>
            <div class="card-body p-0">
                @if (Model.DepartmentGrievances.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-gms align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Ticket</th>
                                    <th>Title</th>
                                    <th>Student</th>
                                    <th>Submitted</th>
                                    <th>Status</th>
                                    <th>Flags</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.DepartmentGrievances)
                                {
                                    var overdueClass = item.IsOverdue && item.Status != GMS.Web.Models.Entities.GrievanceStatus.Resolved ? "row-overdue" : "";
                                    <tr class="@overdueClass">
                                        <td class="fw-bold text-primary">@item.TicketNumber</td>
                                        <td>
                                            <span class="d-block fw-semibold text-dark text-truncate" style="max-width: 250px;">@item.Title</span>
                                            <small class="text-muted">@item.Category?.Name</small>
                                        </td>
                                        <td>
                                            @if (item.IsAnonymous)
                                            {
                                                <span class="text-danger fw-medium"><i class="bi bi-eye-slash-fill me-1"></i> Anonymous</span>
                                            }
                                            else
                                            {
                                                <span class="fw-medium text-dark">@item.Student?.FullName</span>
                                                <small class="text-secondary d-block" style="font-size:0.75rem;">ID: @item.Student?.StudentId</small>
                                            }
                                        </td>
                                        <td class="small text-secondary">@item.SubmittedAt.ToString("d")</td>
                                        <td>
                                            @if (item.Status == GMS.Web.Models.Entities.GrievanceStatus.Open)
                                            {
                                                <span class="badge-status badge-status-open">Open</span>
                                            }
                                            else if (item.Status == GMS.Web.Models.Entities.GrievanceStatus.InProgress)
                                            {
                                                <span class="badge-status badge-status-progress">InProgress</span>
                                            }
                                            else
                                            {
                                                <span class="badge-status badge-status-resolved">Resolved</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column gap-1">
                                                @if (item.Priority == GMS.Web.Models.Entities.GrievancePriority.High)
                                                {
                                                    <span class="badge-status badge-priority-high text-center">High</span>
                                                }
                                                @if (item.IsOverdue && item.Status != GMS.Web.Models.Entities.GrievanceStatus.Resolved)
                                                {
                                                    <span class="badge bg-danger text-white text-center" style="font-size: 0.65rem; padding: 0.2rem 0.4rem;">Overdue</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="text-end">
                                            <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-dark px-3 fw-semibold">
                                                <i class="bi bi-pencil-square me-1"></i> Review
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-inbox-fill text-muted" style="font-size: 3rem;"></i>
                        <h5 class="mt-3 fw-bold text-secondary">No grievances in queue</h5>
                        <p class="text-secondary small mb-0">All department grievances matching filters are resolved or none exist.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Quick Actions & Recent Department Activity -->
    <div class="col-lg-4">
        <!-- Quick Actions Card -->
        <div class="card shadow-sm border-0 rounded-3 bg-white mb-4">
            <div class="card-header bg-light py-3">
                <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-lightning-charge-fill me-2 text-warning"></i> Quick Actions</h5>
            </div>
            <div class="card-body d-flex flex-column gap-2 p-3">
                <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-primary text-start py-2.5 px-3 rounded-3 fw-semibold transition-btn">
                    <i class="bi bi-person-circle me-2"></i> Update My Profile
                </a>
                <a asp-controller="Staff" asp-action="Index" asp-route-myAssigned="true" class="btn btn-outline-success text-start py-2.5 px-3 rounded-3 fw-semibold transition-btn">
                    <i class="bi bi-bookmark-check-fill me-2"></i> View My Assigned Tickets
                </a>
            </div>
        </div>

        <!-- Recent Activity Card -->
        <div class="card shadow-sm border-0 rounded-3 bg-white">
            <div class="card-header bg-light py-3">
                <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-activity me-2 text-danger"></i> Department Timeline</h5>
            </div>
            <div class="card-body p-3">
                @if (Model.RecentActivity.Any())
                {
                    <ul class="list-group list-group-flush timeline-widget small">
                        @foreach (var log in Model.RecentActivity)
                        {
                            <li class="list-group-item bg-transparent border-0 px-0 pb-3">
                                <div class="d-flex justify-content-between text-muted mb-1">
                                    <span class="fw-bold text-dark">Ticket @log.Grievance?.TicketNumber</span>
                                    <span>@log.ChangedAt.ToString("g")</span>
                                </div>
                                <p class="mb-0 text-secondary" style="font-size:0.8rem;">@log.Notes</p>
                                <small class="text-muted d-block mt-0.5">By: @(log.ChangedByUser?.FullName ?? "System")</small>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-center text-muted small my-3">No recent updates in department timeline.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
            var assignData = JSON.parse('@Html.Raw(Model.AssignedVsCompletedJson)');
            var workloadData = JSON.parse('@Html.Raw(Model.MonthlyWorkloadJson)');

            // Assigned vs Completed Chart
            new Chart(document.getElementById('assignedVsCompletedChart'), {
                type: 'doughnut',
                data: {
                    labels: assignData.map(d => d.label),
                    datasets: [{
                        data: assignData.map(d => d.count),
                        backgroundColor: ['#ef4444', '#10b981']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } }
                }
            });

            // Workload Trend Chart
            new Chart(document.getElementById('workloadChart'), {
                type: 'bar',
                data: {
                    labels: workloadData.map(w => w.label),
                    datasets: [{
                        label: 'Grievances Resolved',
                        data: workloadData.map(w => w.count),
                        backgroundColor: '#10b981'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            });
        });
    </script>
}
