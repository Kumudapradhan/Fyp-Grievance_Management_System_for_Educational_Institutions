@model List<GMS.Web.Models.Entities.AuditLog>

@{
    ViewData["Title"] = "Audit Log Viewer";
    Layout = "_AdminLayout";
}

<div class="card shadow-sm border-0 rounded-3 p-4 mb-4 bg-white">
    <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-journal-text me-2 text-primary"></i> System Audit Trail</h3>
    <p class="text-secondary mb-0">Browse and inspect system operations, status changes, and staff assignment actions.</p>
</div>

<!-- Filter Box -->
<div class="card shadow-sm border-0 rounded-3 bg-white mb-4">
    <div class="card-header bg-light py-3">
        <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-funnel-fill me-2 text-primary"></i> Filter Audit Logs</h6>
    </div>
    <div class="card-body p-3">
        <form asp-action="AuditLog" method="get">
            <div class="row g-3 align-items-end">
                <div class="col-md-4 col-sm-6">
                    <label class="form-label small fw-semibold">Search Query</label>
                    <input type="text" name="search" class="form-control form-control-sm form-control-gms" placeholder="Action, Entity Type, User..." value="@ViewBag.SearchQuery" />
                </div>
                <div class="col-md-3 col-sm-3">
                    <label class="form-label small fw-semibold">From Date</label>
                    <input type="date" name="from" class="form-control form-control-sm form-control-gms" value="@ViewBag.FromDate" />
                </div>
                <div class="col-md-3 col-sm-3">
                    <label class="form-label small fw-semibold">To Date</label>
                    <input type="date" name="to" class="form-control form-control-sm form-control-gms" value="@ViewBag.ToDate" />
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-gms-primary btn-sm flex-grow-1">
                        <i class="bi bi-filter"></i> Apply
                    </button>
                    <a asp-action="AuditLog" class="btn btn-gms-secondary btn-sm flex-grow-1 text-center">
                        Reset
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Logs Grid -->
<div class="card shadow-sm border-0 rounded-3 bg-white mb-4">
    <div class="card-header bg-light py-3">
        <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-list-check me-2 text-primary"></i> Audit Entries</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover table-gms align-middle mb-0" style="font-size: 0.85rem;">
                    <thead>
                        <tr>
                            <th style="width: 170px;">Timestamp (UTC)</th>
                            <th>Action</th>
                            <th>User (Operator)</th>
                            <th>Entity Type</th>
                            <th>Entity ID</th>
                            <th>Operation Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="small text-secondary fw-semibold">@log.Timestamp.ToString("g")</td>
                                <td>
                                    <span class="badge bg-secondary font-monospace">@log.Action</span>
                                </td>
                                <td>
                                    @if (log.User != null)
                                    {
                                        <strong>@log.User.FullName</strong>
                                        <small class="text-secondary d-block">@log.User.Email</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted font-monospace">@log.UserId</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@log.EntityType</span>
                                </td>
                                <td class="font-monospace">#@log.EntityId</td>
                                <td class="text-wrap" style="max-width: 400px;">@log.Details</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-journal-x text-muted" style="font-size: 3rem;"></i>
                <h5 class="mt-3 fw-bold text-secondary">No audit logs found</h5>
                <p class="text-secondary small mb-0">No records match the specified search filters.</p>
            </div>
        }
    </div>
</div>

<!-- Pagination Footer -->
@if (ViewBag.TotalPages > 1)
{
    <nav aria-label="Page navigation" class="d-flex justify-content-center">
        <ul class="pagination pagination-sm">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="AuditLog" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-search="@ViewBag.SearchQuery" asp-route-from="@ViewBag.FromDate" asp-route-to="@ViewBag.ToDate">
                    <i class="bi bi-chevron-left"></i> Previous
                </a>
            </li>
            @for (int p = 1; p <= ViewBag.TotalPages; p++)
            {
                <li class="page-item @(ViewBag.CurrentPage == p ? "active" : "")">
                    <a class="page-link" asp-action="AuditLog" asp-route-page="@p" asp-route-search="@ViewBag.SearchQuery" asp-route-from="@ViewBag.FromDate" asp-route-to="@ViewBag.ToDate">@p</a>
                </li>
            }
            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="AuditLog" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-search="@ViewBag.SearchQuery" asp-route-from="@ViewBag.FromDate" asp-route-to="@ViewBag.ToDate">
                    Next <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}
