@model GMS.Web.Models.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Console";
    Layout = "_AdminLayout";
}

<!-- Premium KPI Statistics Row -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3 col-lg border-end">
        <div class="metric-card h-100 border-0 shadow-none py-2 text-center">
            <span class="metric-title text-uppercase font-monospace text-secondary fs-7">Total Users</span>
            <span class="metric-value fs-3 fw-bold text-dark">@Model.TotalUsersCount</span>
        </div>
    </div>
    <div class="col-6 col-md-3 col-lg border-end">
        <div class="metric-card h-100 border-0 shadow-none py-2 text-center">
            <span class="metric-title text-uppercase font-monospace text-secondary fs-7">Departments</span>
            <span class="metric-value fs-3 fw-bold text-dark">@Model.TotalDepartmentsCount</span>
        </div>
    </div>
    <div class="col-6 col-md-3 col-lg border-end">
        <div class="metric-card h-100 border-0 shadow-none py-2 text-center">
            <span class="metric-title text-uppercase font-monospace text-secondary fs-7">Complaints</span>
            <span class="metric-value fs-3 fw-bold text-primary">@Model.TotalCount</span>
        </div>
    </div>
    <div class="col-6 col-md-3 col-lg border-end">
        <div class="metric-card h-100 border-0 shadow-none py-2 text-center">
            <span class="metric-title text-uppercase font-monospace text-secondary fs-7">Open</span>
            <span class="metric-value fs-3 fw-bold text-warning">@Model.OpenCount</span>
        </div>
    </div>
    <div class="col-6 col-md-3 col-lg border-end">
        <div class="metric-card h-100 border-0 shadow-none py-2 text-center">
            <span class="metric-title text-uppercase font-monospace text-secondary fs-7">Resolved</span>
            <span class="metric-value fs-3 fw-bold text-success">@Model.ResolvedCount</span>
        </div>
    </div>
    <div class="col-6 col-md-3 col-lg border-end">
        <div class="metric-card h-100 border-0 shadow-none py-2 text-center">
            <span class="metric-title text-uppercase font-monospace text-secondary fs-7">Overdue</span>
            <span class="metric-value fs-3 fw-bold text-danger">@Model.OverdueCount</span>
        </div>
    </div>
    <div class="col-6 col-md-3 col-lg text-center">
        <div class="metric-card h-100 border-0 shadow-none py-2">
            <span class="metric-title text-uppercase font-monospace text-secondary fs-7">High Priority</span>
            <span class="metric-value fs-3 fw-bold" style="color: #8b5cf6;">@Model.HighPriorityCount</span>
        </div>
    </div>
</div>

<!-- Chart.js Visualization Section -->
<div class="row g-3 mb-4">
    <!-- Row 1: Category & Department breakdown -->
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-3 bg-white h-100">
            <div class="card-header bg-light py-3">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-pie-chart-fill me-2 text-primary"></i> Complaints by Department</h6>
            </div>
            <div class="card-body d-flex justify-content-center align-items-center" style="position: relative; height:260px;">
                <canvas id="deptChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-3 bg-white h-100">
            <div class="card-header bg-light py-3">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-bar-chart-steps me-2 text-success"></i> Complaints by Category</h6>
            </div>
            <div class="card-body d-flex justify-content-center align-items-center" style="position: relative; height:260px;">
                <canvas id="catChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Row 2: Monthly, Time averages, Open vs Closed -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 rounded-3 bg-white h-100">
            <div class="card-header bg-light py-3">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-graph-up me-2 text-info"></i> Monthly Trend</h6>
            </div>
            <div class="card-body d-flex justify-content-center align-items-center" style="position: relative; height:200px;">
                <canvas id="trendChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 rounded-3 bg-white h-100">
            <div class="card-header bg-light py-3">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-hourglass-split me-2 text-warning"></i> Avg Resolution Time (Days)</h6>
            </div>
            <div class="card-body d-flex justify-content-center align-items-center" style="position: relative; height:200px;">
                <canvas id="resTimeChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 rounded-3 bg-white h-100">
            <div class="card-header bg-light py-3">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-pie-chart me-2 text-danger"></i> Open vs Closed</h6>
            </div>
            <div class="card-body d-flex justify-content-center align-items-center" style="position: relative; height:200px;">
                <canvas id="openClosedChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Bottom Layout Splitted Panels -->
<div class="row g-3">
    <!-- Left Column: Grievance Queue filters & list table -->
    <div class="col-lg-8">
        <!-- Filters section -->
        <div class="card shadow-sm border-0 rounded-3 bg-white mb-4">
            <div class="card-header bg-light py-3">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-funnel-fill me-2 text-primary"></i> Filter Grievance Queue</h6>
            </div>
            <div class="card-body p-3">
                <form asp-action="Index" method="get">
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6 col-md-3">
                            <label class="form-label small fw-semibold">Status</label>
                            <select name="status" class="form-select form-select-sm form-control-gms">
                                <option value="">-- All Statuses --</option>
                                @foreach (var val in Enum.GetValues(typeof(GMS.Web.Models.Entities.GrievanceStatus)))
                                {
                                    var selected = Model.SelectedStatus?.ToString() == val.ToString() ? "selected" : "";
                                    <!option value="@val" @selected>@val.ToString()</!option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <label class="form-label small fw-semibold">Department</label>
                            <select name="departmentId" class="form-select form-select-sm form-control-gms">
                                <option value="">-- All Departments --</option>
                                @foreach (var dept in Model.Departments)
                                {
                                    var selected = Model.SelectedDepartmentId == dept.Id ? "selected" : "";
                                    <!option value="@dept.Id" @selected>@dept.Name</!option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <label class="form-label small fw-semibold">Category</label>
                            <select name="categoryId" class="form-select form-select-sm form-control-gms">
                                <option value="">-- All Categories --</option>
                                @foreach (var cat in Model.Categories)
                                {
                                    var selected = Model.SelectedCategoryId == cat.Id ? "selected" : "";
                                    <!option value="@cat.Id" @selected>@cat.Name</!option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <label class="form-label small fw-semibold">Priority</label>
                            <select name="priority" class="form-select form-select-sm form-control-gms">
                                <option value="">-- All Priorities --</option>
                                @foreach (var val in Enum.GetValues(typeof(GMS.Web.Models.Entities.GrievancePriority)))
                                {
                                    var selected = Model.SelectedPriority?.ToString() == val.ToString() ? "selected" : "";
                                    <!option value="@val" @selected>@val.ToString()</!option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label small fw-semibold">Keyword Search</label>
                            <input type="text" name="search" class="form-control form-control-sm form-control-gms" placeholder="Search Ticket, Title, Student..." value="@Model.SearchQuery" />
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <label class="form-label small fw-semibold">Date Submitted (From)</label>
                            <input type="date" name="startDate" class="form-control form-control-sm form-control-gms" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-sm-6 col-md-2">
                            <label class="form-label small fw-semibold">Date Submitted (To)</label>
                            <input type="date" name="endDate" class="form-control form-control-sm form-control-gms" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-2 d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-gms-primary btn-sm flex-grow-1">
                                <i class="bi bi-filter"></i> Apply
                            </button>
                            <a asp-action="Index" class="btn btn-gms-secondary btn-sm flex-grow-1 text-center">
                                Reset
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Recent Complaints table -->
        <div class="card shadow-sm border-0 rounded-3 bg-white">
            <div class="card-header bg-light py-3">
                <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-ticket-perforated-fill me-2 text-primary"></i> Grievance Queue</h5>
            </div>
            <div class="card-body p-0">
                @if (Model.Grievances.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-gms align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Ticket</th>
                                    <th>Title</th>
                                    <th>Student</th>
                                    <th>Department</th>
                                    <th>Submitted</th>
                                    <th>Status</th>
                                    <th>Flags</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Grievances)
                                {
                                    var overdueClass = item.IsOverdue && item.Status != GMS.Web.Models.Entities.GrievanceStatus.Resolved ? "row-overdue" : "";
                                    <tr class="@overdueClass">
                                        <td class="fw-bold text-primary">@item.TicketNumber</td>
                                        <td>
                                            <span class="d-block fw-semibold text-dark text-truncate" style="max-width: 180px;">@item.Title</span>
                                            <small class="text-muted">@item.Category?.Name</small>
                                        </td>
                                        <td>
                                            @if (item.IsAnonymous)
                                            {
                                                <span class="text-danger fw-medium"><i class="bi bi-eye-slash-fill me-1"></i> Anonymous</span>
                                            }
                                            else
                                            {
                                                <span class="fw-medium text-dark">@item.Student?.FullName</span>
                                                <small class="text-secondary d-block" style="font-size:0.75rem;">ID: @item.Student?.StudentId</small>
                                            }
                                        </td>
                                        <td>@item.Department?.Name</td>
                                        <td class="small text-secondary">@item.SubmittedAt.ToString("d")</td>
                                        <td>
                                            @if (item.Status == GMS.Web.Models.Entities.GrievanceStatus.Open)
                                            {
                                                <span class="badge-status badge-status-open">Open</span>
                                            }
                                            else if (item.Status == GMS.Web.Models.Entities.GrievanceStatus.InProgress)
                                            {
                                                <span class="badge-status badge-status-progress">InProgress</span>
                                            }
                                            else
                                            {
                                                <span class="badge-status badge-status-resolved">Resolved</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column gap-1">
                                                @if (item.Priority == GMS.Web.Models.Entities.GrievancePriority.High)
                                                {
                                                    <span class="badge-status badge-priority-high text-center">High</span>
                                                }
                                                @if (item.IsOverdue && item.Status != GMS.Web.Models.Entities.GrievanceStatus.Resolved)
                                                {
                                                    <span class="badge bg-danger text-white text-center" style="font-size: 0.65rem; padding: 0.2rem 0.4rem;">SLA Breach</span>
                                                }
                                                @if (item.IsRepetitive)
                                                {
                                                    <span class="badge bg-purple text-white text-center" style="background-color: #8b5cf6; font-size: 0.65rem; padding: 0.2rem 0.4rem;">Repetitive</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="text-end">
                                            <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-dark px-3 fw-semibold">
                                                <i class="bi bi-pencil-square me-1"></i> Review
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-folder2-open text-muted" style="font-size: 3rem;"></i>
                        <h5 class="mt-3 fw-bold text-secondary">No grievances match the filters</h5>
                        <p class="text-secondary small mb-0">Try expanding your filter parameters.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Quick Actions & Audit Activities -->
    <div class="col-lg-4">
        <!-- Quick Actions Card -->
        <div class="card shadow-sm border-0 rounded-3 bg-white mb-4">
            <div class="card-header bg-light py-3">
                <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-lightning-charge-fill me-2 text-warning"></i> Quick Actions</h5>
            </div>
            <div class="card-body d-flex flex-column gap-2 p-3">
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary text-start py-2.5 px-3 rounded-3 fw-semibold transition-btn">
                    <i class="bi bi-person-plus-fill me-2"></i> Register Academic Staff
                </a>
                <a asp-controller="Admin" asp-action="Users" class="btn btn-outline-info text-start py-2.5 px-3 rounded-3 fw-semibold transition-btn">
                    <i class="bi bi-people-fill me-2"></i> Manage User Accounts
                </a>
                <a asp-controller="Admin" asp-action="Departments" class="btn btn-outline-secondary text-start py-2.5 px-3 rounded-3 fw-semibold transition-btn">
                    <i class="bi bi-building-fill me-2"></i> Setup Departments
                </a>
                <a asp-controller="Admin" asp-action="AuditLog" class="btn btn-outline-danger text-start py-2.5 px-3 rounded-3 fw-semibold transition-btn">
                    <i class="bi bi-journal-text me-2"></i> View System Audit Logs
                </a>
            </div>
        </div>

        <!-- Recent Activity Card -->
        <div class="card shadow-sm border-0 rounded-3 bg-white">
            <div class="card-header bg-light py-3">
                <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-activity me-2 text-danger"></i> Recent System Activity</h5>
            </div>
            <div class="card-body p-3">
                @if (Model.RecentActivity.Any())
                {
                    <ul class="list-group list-group-flush timeline-widget small">
                        @foreach (var log in Model.RecentActivity)
                        {
                            <li class="list-group-item bg-transparent border-0 px-0 pb-3">
                                <div class="d-flex justify-content-between text-muted mb-1">
                                    <span class="fw-bold text-dark">@log.Action</span>
                                    <span>@log.Timestamp.ToString("t")</span>
                                </div>
                                <p class="mb-0 text-secondary" style="font-size:0.8rem;">@log.Details</p>
                                <small class="text-muted d-block mt-0.5">By: @(log.User?.FullName ?? "System")</small>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-center text-muted small my-3">No recent system activity logged.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
            // Safe JSON parses
            var deptData = JSON.parse('@Html.Raw(Model.ComplaintsByDepartmentJson)');
            var catData = JSON.parse('@Html.Raw(Model.ComplaintsByCategoryJson)');
            var trendData = JSON.parse('@Html.Raw(Model.MonthlyComplaintTrendJson)');
            var openClosedData = JSON.parse('@Html.Raw(Model.OpenVsClosedJson)');
            var resTimeData = JSON.parse('@Html.Raw(Model.AverageResolutionTimeJson)');

            // Department Chart
            new Chart(document.getElementById('deptChart'), {
                type: 'doughnut',
                data: {
                    labels: deptData.map(d => d.label),
                    datasets: [{
                        data: deptData.map(d => d.count),
                        backgroundColor: ['#1e40af', '#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 10 } } } }
                }
            });

            // Category Chart
            new Chart(document.getElementById('catChart'), {
                type: 'bar',
                data: {
                    labels: catData.map(c => c.label),
                    datasets: [{
                        label: 'Tickets',
                        data: catData.map(c => c.count),
                        backgroundColor: '#10b981'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            });

            // Monthly Trend Chart
            new Chart(document.getElementById('trendChart'), {
                type: 'line',
                data: {
                    labels: trendData.map(t => t.label),
                    datasets: [{
                        label: 'Grievances',
                        data: trendData.map(t => t.count),
                        borderColor: '#3b82f6',
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',
                        fill: true,
                        tension: 0.3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            });

            // Average Resolution Time Chart
            new Chart(document.getElementById('resTimeChart'), {
                type: 'bar',
                data: {
                    labels: resTimeData.map(r => r.label),
                    datasets: [{
                        label: 'Days',
                        data: resTimeData.map(r => r.count),
                        backgroundColor: '#f59e0b'
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { x: { beginAtZero: true } }
                }
            });

            // Open vs Closed Chart
            new Chart(document.getElementById('openClosedChart'), {
                type: 'pie',
                data: {
                    labels: openClosedData.map(o => o.label),
                    datasets: [{
                        data: openClosedData.map(o => o.count),
                        backgroundColor: ['#ef4444', '#10b981']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 10 } } } }
                }
            });
        });
    </script>
}
