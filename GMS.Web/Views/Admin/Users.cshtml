@model GMS.Web.Models.ViewModels.UserManagementViewModel

@{
    ViewData["Title"] = "User Management";
    Layout = "_AdminLayout";
}

<div class="card shadow-sm border-0 rounded-3 p-4 mb-4 bg-white">
    <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-people-fill me-2 text-primary"></i> User Management Portal</h3>
    <p class="text-secondary mb-0">View registered users, track their submissions, and toggle account activation status.</p>
</div>

<!-- Filters Section -->
<div class="card shadow-sm border-0 rounded-3 bg-white mb-4">
    <div class="card-header bg-light py-3">
        <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-funnel-fill me-2 text-primary"></i> Filter Accounts</h6>
    </div>
    <div class="card-body p-3">
        <form asp-action="Users" method="get">
            <div class="row g-3 align-items-end">
                <div class="col-sm-6 col-md-3">
                    <label class="form-label small fw-semibold">Role Type</label>
                    <select name="role" class="form-select form-select-sm form-control-gms">
                        <option value="">-- All Roles --</option>
                        @foreach (var r in new[] { "Student", "Staff" })
                        {
                            var selected = Model.SelectedRole == r ? "selected" : "";
                            <!option value="@r" @selected>@r</!option>
                        }
                    </select>
                </div>
                <div class="col-md-6 col-sm-6">
                    <label class="form-label small fw-semibold">Search keyword</label>
                    <input type="text" name="search" class="form-control form-control-sm form-control-gms" placeholder="Search by name, email, or Student ID..." value="@Model.SearchQuery" />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-gms-primary btn-sm flex-grow-1">
                        <i class="bi bi-filter"></i> Apply Filters
                    </button>
                    <a asp-action="Users" class="btn btn-gms-secondary btn-sm flex-grow-1 text-center">
                        Reset
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- User Accounts Table -->
<div class="card shadow-sm border-0 rounded-3 bg-white">
    <div class="card-header bg-light py-3">
        <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-list-check me-2 text-primary"></i> Registered Users</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Users.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover table-gms align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Full Name</th>
                            <th>Email Address</th>
                            <th>Student ID / Dept</th>
                            <th>Role</th>
                            <th class="text-center">Active Status</th>
                            <th class="text-center">Grievances</th>
                            <th>Registered</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>
                                    <span class="d-block fw-bold text-dark">@user.FullName</span>
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    @if (user.Role == "Student")
                                    {
                                        <span class="text-secondary small">ID: <strong>@user.StudentId</strong></span>
                                    }
                                    else if (user.Role == "Staff")
                                    {
                                        <span class="text-secondary small">Dept: <strong>@user.Department</strong></span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    @if (user.Role == "Administrator")
                                    {
                                        <span class="badge bg-danger">Admin</span>
                                    }
                                    else if (user.Role == "Staff")
                                    {
                                        <span class="badge bg-info text-dark">Staff</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">Student</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2.5 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2.5 py-1">Inactive</span>
                                    }
                                </td>
                                <td class="text-center fw-bold">
                                    @(user.Role == "Student" ? user.GrievanceCount.ToString() : "N/A")
                                </td>
                                <td class="small text-secondary">@user.CreatedAt.ToString("d")</td>
                                <td class="text-end">
                                    <form asp-action="ToggleUserStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        @if (user.IsActive)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-danger px-3 fw-semibold">
                                                <i class="bi bi-person-x me-1"></i> Deactivate
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success px-3 fw-semibold">
                                                <i class="bi bi-person-check me-1"></i> Activate
                                            </button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-people text-muted" style="font-size: 3rem;"></i>
                <h5 class="mt-3 fw-bold text-secondary">No users found</h5>
                <p class="text-secondary small mb-0">Try clearing filters or checking spelling.</p>
            </div>
        }
    </div>
</div>
