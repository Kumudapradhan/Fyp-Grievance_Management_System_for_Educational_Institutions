@model List<GMS.Web.Models.Entities.Department>

@{
    ViewData["Title"] = "Department Setup";
    Layout = "_AdminLayout";
}

<div class="card shadow-sm border-0 rounded-3 p-4 mb-4 bg-white">
    <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-building-fill me-2 text-primary"></i> Department & Staff Mapping</h3>
    <p class="text-secondary mb-0">Assign staff officers responsible for review of complaints routed to each department.</p>
</div>

<!-- Department Assignment Table -->
<div class="card shadow-sm border-0 rounded-3 bg-white">
    <div class="card-header bg-light py-3">
        <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-diagram-3-fill me-2 text-primary"></i> Department Queue Ownership</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover table-gms align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width: 250px;">Department</th>
                            <th>Description</th>
                            <th>Assigned Staff Officer</th>
                            <th style="width: 350px;" class="text-end">Assign / Reassign Officer</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dept in Model)
                        {
                            <tr>
                                <td>
                                    <span class="d-block fw-bold text-dark">@dept.Name</span>
                                </td>
                                <td>
                                    <span class="text-secondary small">@dept.Description</span>
                                </td>
                                <td>
                                    @if (dept.StaffUser != null)
                                    {
                                        <div class="d-flex align-items-center">
                                            <div class="p-1.5 bg-primary bg-opacity-10 rounded text-primary me-2 small">
                                                <i class="bi bi-person-fill"></i>
                                            </div>
                                            <div>
                                                <strong class="d-block text-dark small">@dept.StaffUser.FullName</strong>
                                                <small class="text-secondary" style="font-size: 0.75rem;">@dept.StaffUser.Email</small>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2.5 py-1">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Unassigned
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <form asp-action="AssignDepartmentStaff" method="post" class="d-flex align-items-center justify-content-end gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="departmentId" value="@dept.Id" />
                                        
                                        <select name="staffUserId" class="form-select form-select-sm form-control-gms" style="max-width: 230px;">
                                            <option value="">-- Unassign / None --</option>
                                            @foreach (var staff in (List<GMS.Web.Models.Entities.ApplicationUser>)ViewBag.StaffUsers)
                                            {
                                                var isSelected = dept.StaffUserId == staff.Id ? "selected" : "";
                                                <!option value="@staff.Id" @isSelected>@staff.FullName</!option>
                                            }
                                        </select>
                                        
                                        <button type="submit" class="btn btn-sm btn-primary btn-gms-primary px-3 fw-semibold">
                                            Save
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-building text-muted" style="font-size: 3rem;"></i>
                <h5 class="mt-3 fw-bold text-secondary">No departments seeded</h5>
                <p class="text-secondary small mb-0">Check the database initializer configuration.</p>
            </div>
        }
    </div>
</div>
