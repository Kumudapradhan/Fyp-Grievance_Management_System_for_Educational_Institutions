@model GMS.Web.Models.ViewModels.GrievanceDetailViewModel

@{
    ViewData["Title"] = $"Review {Model.Grievance.TicketNumber}";
    Layout = "_AdminLayout";
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-sm btn-gms-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Queue
    </a>
</div>

<!-- Header card -->
<div class="card shadow-sm border-0 rounded-3 mb-4 bg-white">
    <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
        <div>
            <span class="badge bg-primary mb-1">ADMIN TICKET REVIEW</span>
            <h4 class="mb-0 fw-bold">@Model.Grievance.TicketNumber</h4>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (Model.Grievance.Priority == GMS.Web.Models.Entities.GrievancePriority.High)
            {
                <span class="badge bg-danger text-white fs-6">HIGH PRIORITY</span>
            }
            @if (Model.Grievance.IsOverdue && Model.Grievance.Status != GMS.Web.Models.Entities.GrievanceStatus.Resolved)
            {
                <span class="badge bg-warning text-dark fs-6">SLA BREACH</span>
            }
            @if (Model.Grievance.Status == GMS.Web.Models.Entities.GrievanceStatus.Open)
            {
                <span class="badge-status badge-status-open fs-6">Open</span>
            }
            else if (Model.Grievance.Status == GMS.Web.Models.Entities.GrievanceStatus.InProgress)
            {
                <span class="badge-status badge-status-progress fs-6">InProgress</span>
            }
            else
            {
                <span class="badge-status badge-status-resolved fs-6">Resolved</span>
            }
        </div>
    </div>
    
    <div class="card-body p-4">
        <!-- Submitter info card (Anonymity logic FR-05) -->
        <div class="p-3 bg-light rounded-3 border mb-4">
            <h6 class="fw-bold text-secondary mb-2"><i class="bi bi-person-fill me-1"></i> Submitter Details</h6>
            @if (Model.Grievance.IsAnonymous)
            {
                <div class="text-danger fw-bold fs-6">
                    <i class="bi bi-eye-slash-fill me-2"></i> Anonymous Student Filing
                </div>
                <small class="text-muted d-block mt-1">This grievance was submitted anonymously. Student profile metadata is hidden to maintain privacy.</small>
            }
            else
            {
                <div class="row g-2">
                    <div class="col-sm-4">
                        <span class="text-muted small d-block">NAME</span>
                        <strong class="text-dark">@Model.Grievance.Student?.FullName</strong>
                    </div>
                    <div class="col-sm-4">
                        <span class="text-muted small d-block">STUDENT ID</span>
                        <strong class="text-dark">@Model.Grievance.Student?.StudentId</strong>
                    </div>
                    <div class="col-sm-4">
                        <span class="text-muted small d-block">EMAIL</span>
                        <strong class="text-dark">@Model.Grievance.Student?.Email</strong>
                    </div>
                </div>
            }
        </div>

        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <span class="text-muted small d-block">CATEGORY</span>
                <span class="fw-semibold">@Model.Grievance.Category?.Name</span>
            </div>
            <div class="col-6 col-md-3">
                <span class="text-muted small d-block">CURRENT DEPT ASSIGNED</span>
                <span class="fw-semibold">@Model.Grievance.Department?.Name</span>
            </div>
            <div class="col-6 col-md-3">
                <span class="text-muted small d-block">INCIDENT DATE</span>
                <span class="fw-semibold">@Model.Grievance.IncidentDate.ToString("D")</span>
            </div>
            <div class="col-6 col-md-3">
                <span class="text-muted small d-block">SUBMITTED DATE</span>
                <span class="fw-semibold">@Model.Grievance.SubmittedAt.ToString("g")</span>
            </div>
        </div>

        <hr class="my-4" />

        <div class="mb-4">
            <h5 class="fw-bold mb-2 text-dark">Subject Title</h5>
            <p class="fs-5 fw-semibold text-dark">@Model.Grievance.Title</p>
        </div>

        <div class="mb-4">
            <h5 class="fw-bold mb-2 text-dark">Description details</h5>
            <div class="p-3 bg-light rounded border text-secondary" style="white-space: pre-wrap; line-height: 1.6;">@Model.Grievance.Description</div>
        </div>

        <!-- Evidence attachments -->
        <div class="mb-4">
            <h5 class="fw-bold mb-2 text-dark"><i class="bi bi-paperclip me-1"></i> Uploaded Evidence</h5>
            @if (Model.Grievance.Attachments.Any())
            {
                <div class="row g-2">
                    @foreach (var file in Model.Grievance.Attachments)
                    {
                        <div class="col-md-6">
                            <div class="p-2 border rounded-3 d-flex justify-content-between align-items-center bg-light">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-file-earmark-text text-primary fs-4 me-2"></i>
                                    <div>
                                        <span class="d-block text-dark fw-medium text-truncate" style="max-width: 200px;" title="@file.FileName">@file.FileName</span>
                                        <small class="text-secondary">@Math.Round((double)file.FileSize / 1024, 1) KB</small>
                                    </div>
                                </div>
                                <a asp-controller="Grievance" asp-action="DownloadAttachment" asp-route-id="@file.Id" class="btn btn-sm btn-primary px-3">
                                    <i class="bi bi-download"></i> Download
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="small text-secondary italic mb-0">No files uploaded for this ticket.</p>
            }
        </div>

        @if (Model.Grievance.Status == GMS.Web.Models.Entities.GrievanceStatus.Resolved)
        {
            <div class="p-3 border border-success bg-success bg-opacity-10 rounded-3 mb-4">
                <h5 class="fw-bold text-success-emphasis mb-1"><i class="bi bi-check-circle-fill me-2"></i> Resolution Statement</h5>
                <p class="text-secondary mb-0" style="white-space: pre-wrap;">@Model.Grievance.ResolutionNotes</p>
            </div>
        }
    </div>
</div>

<!-- Admin Actions Panel -->
<div class="row g-4 mb-4">
    <!-- Status Update Form -->
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-3 bg-white h-100">
            <div class="card-header bg-light py-3">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-arrow-repeat me-2 text-primary"></i> Update Ticket Status</h6>
            </div>
            <div class="card-body p-4">
                <form asp-action="UpdateStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Grievance.Id" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold">New Status</label>
                        <select asp-for="NewStatus" class="form-select form-control-gms" id="statusDropdown">
                            @foreach (var val in Enum.GetValues(typeof(GMS.Web.Models.Entities.GrievanceStatus)))
                            {
                                <option value="@val">@val.ToString()</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Status / Resolution Notes</label>
                        <textarea asp-for="StatusNotes" class="form-control form-control-gms" rows="4" id="statusNotesBox" placeholder="Provide notes or resolution details... (Required if status is set to Resolved)"></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary btn-gms-primary w-100 py-2">
                        Update Status
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Department Routing Form -->
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-3 bg-white h-100">
            <div class="card-header bg-light py-3">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-arrow-right-left me-2 text-primary"></i> Re-Route Department</h6>
            </div>
            <div class="card-body p-4">
                <form asp-action="ReRoute" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Grievance.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Target Department</label>
                        <select asp-for="NewDepartmentId" class="form-select form-control-gms">
                            @foreach (var dept in Model.AllDepartments)
                            {
                                <option value="@dept.Id">@dept.Name</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Re-routing Notes</label>
                        <textarea asp-for="ReRouteNotes" class="form-control form-control-gms" rows="4" placeholder="Explain the rationale for transferring this ticket..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-dark w-100 py-2 fw-semibold">
                        Re-Route Ticket
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Assign Staff Panel (Feature 4) -->
<div class="card shadow-sm border-0 rounded-3 bg-white mb-4">
    <div class="card-header bg-light py-3">
        <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-person-fill-gear me-2 text-primary"></i> Assign to Specific Staff Member</h6>
    </div>
    <div class="card-body p-4">
        @if (Model.Grievance.AssignedStaffUserId != null)
        {
            <div class="alert alert-info border-0 bg-info bg-opacity-10 text-dark small mb-3">
                <i class="bi bi-info-circle-fill me-2"></i> Currently assigned to: <strong>@Model.Grievance.AssignedStaffUser?.FullName</strong> (@(Model.Grievance.AssignedStaffUser?.Department ?? "No Department"))
            </div>
        }
        else
        {
            <div class="alert alert-warning border-0 bg-warning bg-opacity-10 text-dark small mb-3">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> This grievance has not been assigned to a specific staff member yet. It is currently unassigned.
            </div>
        }
        
        <form asp-action="AssignStaff" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="grievanceId" value="@Model.Grievance.Id" />
            
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Select Staff Member</label>
                        <select name="staffUserId" class="form-select form-control-gms" required>
                            <option value="">-- Choose Staff Officer --</option>
                            @foreach (var staff in Model.AllStaffUsers)
                            {
                                var isSelected = Model.Grievance.AssignedStaffUserId == staff.Id ? "selected" : "";
                                <!option value="@staff.Id" @isSelected>@staff.FullName (@(staff.Department ?? "No Department") - @staff.Email)</!option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Note for staff member (optional)</label>
                        <textarea name="assignmentNote" class="form-control form-control-gms" rows="2" placeholder="Provide context or instructions for this assignment..."></textarea>
                    </div>
                </div>
            </div>
            
            <button type="submit" class="btn btn-primary btn-gms-primary fw-semibold px-4">
                Assign Staff
            </button>
        </form>
    </div>
</div>

<!-- History Log -->
<div class="card shadow-sm border-0 rounded-3 bg-white">
    <div class="card-header bg-light py-3">
        <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-clock-history me-2 text-primary"></i> Status & Re-routing Log</h5>
    </div>
    <div class="card-body p-4">
        @if (Model.Grievance.StatusHistory.Any())
        {
            <div class="position-relative border-start border-2 border-light ps-4">
                @foreach (var history in Model.Grievance.StatusHistory.OrderByDescending(sh => sh.ChangedAt))
                {
                    <div class="mb-4 position-relative">
                        <div class="position-absolute" style="left: -33px; top: 0px; background: white; padding: 2px;">
                            @if (history.NewStatus == GMS.Web.Models.Entities.GrievanceStatus.Resolved)
                            {
                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            }
                            else if (history.NewStatus == GMS.Web.Models.Entities.GrievanceStatus.InProgress)
                            {
                                <i class="bi bi-hourglass-split text-warning fs-5"></i>
                            }
                            else
                            {
                                <i class="bi bi-circle-fill text-primary fs-5"></i>
                            }
                        </div>
                        <div>
                            <span class="small text-muted d-block">@history.ChangedAt.ToString("f") | Modified by user: <strong>@history.ChangedByUser?.FullName (@history.ChangedByUser?.Email)</strong></span>
                            <strong class="text-dark">Status: @history.NewStatus.ToString()</strong>
                            @if (!string.IsNullOrEmpty(history.Notes))
                            {
                                <p class="text-secondary small mt-1 mb-0 italic">"@history.Notes"</p>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="small text-secondary italic mb-0">No history logged yet.</p>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            function checkNotesRequired() {
                var selected = $('#statusDropdown').val();
                if (selected === 'Resolved') {
                    $('#statusNotesBox').attr('required', 'required');
                    $('#statusNotesBox').attr('placeholder', 'Please provide detailed resolution notes for the student... (REQUIRED)');
                } else {
                    $('#statusNotesBox').removeAttr('required');
                    $('#statusNotesBox').attr('placeholder', 'Provide notes or resolution details...');
                }
            }

            $('#statusDropdown').change(checkNotesRequired);
            checkNotesRequired();
        });
    </script>
}
