@model GMS.Web.Models.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-3 overflow-hidden bg-white">
            <div class="card-header bg-dark text-white text-center py-4">
                <h4 class="mb-0 fw-bold"><i class="bi bi-shield-lock-fill me-2 text-primary"></i> Reset Password</h4>
                <p class="small text-muted mb-0 mt-1">Enter your email and configure your new password</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Token" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                        <input asp-for="Email" class="form-control form-control-gms" placeholder="e.g. name@gms.edu.my" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">New Password</label>
                        <input asp-for="Password" type="password" class="form-control form-control-gms" placeholder="Min 6 characters" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm New Password</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control form-control-gms" placeholder="Re-enter new password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-gms-primary w-100 py-2.5">
                        <i class="bi bi-check-circle-fill me-1"></i> Save New Password
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
