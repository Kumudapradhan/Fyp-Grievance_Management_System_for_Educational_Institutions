@model GMS.Web.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-3 overflow-hidden bg-white">
            <div class="card-header bg-dark text-white text-center py-4">
                <h4 class="mb-0 fw-bold"><i class="bi bi-key-fill me-2 text-primary"></i> Recover Password</h4>
                <p class="small text-muted mb-0 mt-1">Enter your registered email address to request a reset link</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                        <input asp-for="Email" class="form-control form-control-gms" placeholder="e.g. name@gms.edu.my" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-gms-primary w-100 py-2.5 mb-3">
                        <i class="bi bi-send me-1"></i> Send Recovery Link
                    </button>

                    <div class="text-center">
                        <a asp-action="Login" class="small fw-semibold text-decoration-none"><i class="bi bi-arrow-left me-1"></i> Return to Login</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
