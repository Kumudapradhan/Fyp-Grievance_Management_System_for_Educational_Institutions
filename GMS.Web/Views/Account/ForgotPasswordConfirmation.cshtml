@{
    ViewData["Title"] = "Recovery Email Sent";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-3 overflow-hidden bg-white text-center p-4">
            <div class="card-body">
                <div class="mb-4">
                    <i class="bi bi-envelope-check text-success" style="font-size: 4rem;"></i>
                </div>
                <h3 class="fw-bold mb-3">Recovery Request Received</h3>
                <p class="text-secondary mb-4">
                    If the email matches an active account, we have dispatched a password reset link to it. Please check your inbox (and spam folder).
                </p>

                @if (TempData["ResetLink"] != null)
                {
                    <div class="alert alert-warning text-start border-0 rounded-3 mb-4 shadow-sm">
                        <h6 class="fw-bold"><i class="bi bi-bug-fill me-1"></i> Sandbox Test Override:</h6>
                        <p class="small mb-2">Since the system is in development sandbox mode, the generated link is below:</p>
                        <a href="@TempData["ResetLink"]" class="alert-link text-break font-monospace small">@TempData["ResetLink"]</a>
                    </div>
                }

                <a asp-action="Login" class="btn btn-outline-primary px-4 fw-semibold">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Back to Login
                </a>
            </div>
        </div>
    </div>
</div>
