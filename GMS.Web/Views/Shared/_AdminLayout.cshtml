@{
    Layout = "_Layout";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    
    string IsActive(string controller, string action)
    {
        return (currentController == controller && currentAction == action) ? "active bg-primary text-white" : "";
    }
    
    string IconColor(string controller, string action)
    {
        return (currentController == controller && currentAction == action) ? "text-white" : "text-primary";
    }
}

<style>
    .admin-sidebar-wrapper {
        position: sticky;
        top: 20px;
    }
    .admin-sidebar-wrapper .card,
    .admin-sidebar-wrapper .card-header,
    .admin-sidebar-wrapper .list-group,
    .admin-sidebar-wrapper .list-group-item {
        background-color: #f1f5f9 !important;
        border-color: #e2e8f0 !important;
    }
    .admin-sidebar-wrapper .card-header {
        color: #1e293b !important;
    }
    .admin-list-item {
        transition: all 0.2s ease-in-out;
        color: #334155 !important;
    }
    .admin-list-item:hover {
        background-color: #e2e8f0 !important;
        transform: translateX(5px);
        color: #1e293b !important;
    }
    .admin-list-item.active {
        background-color: #1e40af !important;
        color: white !important;
    }
    .admin-list-item.active:hover {
        background-color: #1e3a8a !important;
        transform: none;
    }
</style>

<div class="row">
    <!-- Admin Sidebar -->
    <div class="col-lg-3 mb-4">
        <div class="admin-sidebar-wrapper">
            <div class="card shadow-sm rounded-3 overflow-hidden">
                <div class="card-header py-3">
                    <h5 class="card-title mb-0 fw-bold"><i class="bi bi-sliders me-2"></i> Admin Panel</h5>
                </div>
                <div class="list-group list-group-flush bg-transparent">
                    <a asp-controller="Admin" asp-action="Index" class="list-group-item list-group-item-action py-3 border-0 d-flex align-items-center admin-list-item bg-transparent @IsActive("Admin", "Index")">
                        <i class="bi bi-speedometer2 fs-5 me-3 @IconColor("Admin", "Index")"></i>
                        <div>
                            <span class="d-block fw-semibold">Dashboard</span>
                            <small class="opacity-75">Grievance console</small>
                        </div>
                    </a>
                    <a asp-controller="Admin" asp-action="Users" class="list-group-item list-group-item-action py-3 border-0 d-flex align-items-center border-top admin-list-item bg-transparent @IsActive("Admin", "Users")">
                        <i class="bi bi-people fs-5 me-3 @IconColor("Admin", "Users")"></i>
                        <div>
                            <span class="d-block fw-semibold">User Management</span>
                            <small class="opacity-75">Manage active accounts</small>
                        </div>
                    </a>
                    <a asp-controller="Admin" asp-action="Departments" class="list-group-item list-group-item-action py-3 border-0 d-flex align-items-center border-top admin-list-item bg-transparent @IsActive("Admin", "Departments")">
                        <i class="bi bi-building fs-5 me-3 @IconColor("Admin", "Departments")"></i>
                        <div>
                            <span class="d-block fw-semibold">Department Setup</span>
                            <small class="opacity-75">Staff assignments</small>
                        </div>
                    </a>
                    <a asp-controller="Report" asp-action="Index" class="list-group-item list-group-item-action py-3 border-0 d-flex align-items-center border-top admin-list-item bg-transparent @IsActive("Report", "Index")">
                        <i class="bi bi-graph-up-arrow fs-5 me-3 @IconColor("Report", "Index")"></i>
                        <div>
                            <span class="d-block fw-semibold">Analytics & Reports</span>
                            <small class="opacity-75">SLA and metrics charts</small>
                        </div>
                    </a>
                    <a asp-controller="Admin" asp-action="AuditLog" class="list-group-item list-group-item-action py-3 border-0 d-flex align-items-center border-top admin-list-item bg-transparent @IsActive("Admin", "AuditLog")">
                        <i class="bi bi-journal-text fs-5 me-3 @IconColor("Admin", "AuditLog")"></i>
                        <div>
                            <span class="d-block fw-semibold">Audit Log</span>
                            <small class="opacity-75">System actions history</small>
                        </div>
                    </a>
                    <a asp-controller="Grievance" asp-action="Track" class="list-group-item list-group-item-action py-3 border-0 d-flex align-items-center border-top admin-list-item bg-transparent @IsActive("Grievance", "Track")">
                        <i class="bi bi-search fs-5 me-3 @IconColor("Grievance", "Track")"></i>
                        <div>
                            <span class="d-block fw-semibold">Verify Ticket</span>
                            <small class="opacity-75">Direct search</small>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Admin Page Body -->
    <div class="col-lg-9">
        @RenderBody()
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
