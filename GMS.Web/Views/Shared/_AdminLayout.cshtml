@{
    Layout = null; // No wrapper layout
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    
    string IsActive(string controller, string action)
    {
        return (currentController == controller && currentAction == action) ? "active-link" : "";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Dashboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* Specific Admin Layout Styles */
        body {
            background-color: #f8fafc; /* Very light gray/blue background */
            font-family: var(--font-family);
            margin: 0;
            overflow-x: hidden;
        }
        
        /* Layout Grid */
        .admin-layout {
            display: flex;
            min-height: 100vh;
        }
        
        /* Sidebar */
        .admin-sidebar {
            width: 260px;
            background-color: #ffffff;
            border-right: 1px dashed #cbd5e1;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            z-index: 1000;
        }
        
        .sidebar-brand {
            padding: 24px;
            display: flex;
            align-items: center;
            font-weight: 700;
            font-size: 1.25rem;
            color: #1e293b;
        }
        .sidebar-brand-icon {
            background-color: #2563eb;
            color: white;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            margin-right: 12px;
            font-size: 1rem;
        }
        
        .sidebar-section-title {
            font-size: 0.7rem;
            text-transform: uppercase;
            font-weight: 600;
            color: #94a3b8;
            letter-spacing: 0.05em;
            padding: 16px 24px 8px;
        }
        
        .sidebar-menu {
            list-style: none;
            padding: 0 12px;
            margin: 0;
            flex-grow: 1;
        }
        
        .sidebar-menu-item {
            margin-bottom: 4px;
        }
        
        .sidebar-menu-link {
            display: flex;
            align-items: center;
            padding: 10px 16px;
            color: #475569;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 500;
            font-size: 0.95rem;
            transition: all 0.2s;
        }
        
        .sidebar-menu-link:hover {
            background-color: #f1f5f9;
            color: #1e293b;
        }
        
        .sidebar-menu-link i {
            margin-right: 12px;
            font-size: 1.1rem;
            color: #94a3b8;
            transition: color 0.2s;
        }
        
        .sidebar-menu-link:hover i {
            color: #64748b;
        }
        
        .sidebar-menu-link.active-link {
            background-color: #eff6ff; /* Light blue bg */
            color: #2563eb; /* Blue text */
            font-weight: 600;
        }
        
        .sidebar-menu-link.active-link i {
            color: #2563eb;
        }
        
        .sidebar-footer {
            padding: 24px;
            background-color: #f8fafc;
        }
        
        .sidebar-user {
            display: flex;
            align-items: center;
            margin-bottom: 16px;
        }
        
        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background-color: #2563eb;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 0.9rem;
            margin-right: 12px;
        }
        
        .user-info {
            display: flex;
            flex-direction: column;
        }
        
        .user-name {
            font-weight: 600;
            font-size: 0.9rem;
            color: #1e293b;
            line-height: 1.2;
        }
        
        .user-role {
            font-size: 0.75rem;
            color: #94a3b8;
        }
        
        .logout-link {
            display: flex;
            align-items: center;
            color: #475569;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            transition: color 0.2s;
        }
        .logout-link:hover {
            color: #ef4444;
        }
        .logout-link i {
            margin-right: 8px;
            font-size: 1.1rem;
        }
        
        /* Main Content */
        .admin-main {
            flex-grow: 1;
            margin-left: 260px;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        
        /* Topbar */
        .admin-topbar {
            height: 72px;
            background-color: #ffffff;
            border-bottom: 1px dashed #cbd5e1;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 32px;
            position: sticky;
            top: 0;
            z-index: 999;
        }
        
        .topbar-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: #1e293b;
            margin: 0;
        }
        
        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 20px;
        }
        
        .topbar-icon {
            color: #64748b;
            font-size: 1.2rem;
            cursor: pointer;
            transition: color 0.2s;
            position: relative;
            display: flex;
            align-items: center;
        }
        .topbar-icon:hover {
            color: #1e293b;
        }
        .notification-dot {
            position: absolute;
            top: 0px;
            right: 0px;
            width: 8px;
            height: 8px;
            background-color: #ef4444;
            border-radius: 50%;
            border: 2px solid white;
        }
        
        .content-area {
            padding: 32px;
            flex-grow: 1;
        }
    </style>
</head>
<body>
    <div class="admin-layout">
        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <div class="sidebar-brand">
                <div class="sidebar-brand-icon">O</div>
                GMS
            </div>
            
            <div class="sidebar-section-title">Administration</div>
            
            <ul class="sidebar-menu">
                <li class="sidebar-menu-item">
                    <a asp-controller="Admin" asp-action="Index" class="sidebar-menu-link @IsActive("Admin", "Index")">
                        <i class="bi bi-grid"></i> Dashboard
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a asp-controller="Grievance" asp-action="Track" class="sidebar-menu-link @IsActive("Grievance", "Track")">
                        <i class="bi bi-file-earmark-text"></i> Manage Complaints
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a asp-controller="Admin" asp-action="Departments" class="sidebar-menu-link @IsActive("Admin", "Departments")">
                        <i class="bi bi-building"></i> Departments
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a asp-controller="Admin" asp-action="Users" class="sidebar-menu-link @IsActive("Admin", "Users")">
                        <i class="bi bi-people"></i> User Management
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a asp-controller="Report" asp-action="Index" class="sidebar-menu-link @IsActive("Report", "Index")">
                        <i class="bi bi-bar-chart"></i> Reports & Analytics
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a asp-controller="Admin" asp-action="AuditLog" class="sidebar-menu-link @IsActive("Admin", "AuditLog")">
                        <i class="bi bi-gear"></i> Settings
                    </a>
                </li>
            </ul>
            
            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <div class="user-avatar">AU</div>
                    <div class="user-info">
                        <span class="user-name">Admin Use</span>
                        <span class="user-role">Admin</span>
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                    @Html.AntiForgeryToken()
                    <a href="javascript:document.getElementById('logoutForm').submit()" class="logout-link">
                        <i class="bi bi-box-arrow-right"></i> Log out
                    </a>
                </form>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="admin-main">
            <!-- Topbar -->
            <header class="admin-topbar">
                <h1 class="topbar-title">Admin Dashboard</h1>
                <div class="topbar-actions">
                    <div class="topbar-icon">
                        <i class="bi bi-bell"></i>
                        <span class="notification-dot"></span>
                    </div>
                    <div class="topbar-icon">
                        <i class="bi bi-gear"></i>
                    </div>
                    <div class="user-avatar" style="margin-right: 0; width: 32px; height: 32px; font-size: 0.8rem;">AR</div>
                </div>
            </header>

            <!-- Render Body -->
            <div class="content-area">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
