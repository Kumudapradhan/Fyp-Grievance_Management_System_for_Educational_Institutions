@{
    Layout = "_Layout";
}

<div class="row">
    <!-- Admin Sidebar -->
    <div class="col-lg-3 mb-4">
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="card-title mb-0"><i class="bi bi-sliders me-2"></i> Admin Panel</h5>
            </div>
            <div class="list-group list-group-flush">
                <a asp-controller="Admin" asp-action="Index" class="list-group-item list-group-item-action py-3 border-0 d-flex align-items-center">
                    <i class="bi bi-speedometer2 text-primary fs-5 me-3"></i>
                    <div>
                        <span class="d-block fw-semibold text-dark">Dashboard</span>
                        <small class="text-muted">Grievance console</small>
                    </div>
                </a>
                <a asp-controller="Report" asp-action="Index" class="list-group-item list-group-item-action py-3 border-0 d-flex align-items-center border-top">
                    <i class="bi bi-graph-up-arrow text-success fs-5 me-3"></i>
                    <div>
                        <span class="d-block fw-semibold text-dark">Analytics & Reports</span>
                        <small class="text-muted">SLA and metrics charts</small>
                    </div>
                </a>
                <a asp-controller="Grievance" asp-action="Track" class="list-group-item list-group-item-action py-3 border-0 d-flex align-items-center border-top">
                    <i class="bi bi-search text-warning fs-5 me-3"></i>
                    <div>
                        <span class="d-block fw-semibold text-dark">Verify Ticket</span>
                        <small class="text-muted">Direct search</small>
                    </div>
                </a>
            </div>
        </div>
    </div>
    
    <!-- Admin Page Body -->
    <div class="col-lg-9">
        @RenderBody()
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
