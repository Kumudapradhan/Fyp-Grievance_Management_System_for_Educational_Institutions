@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 text-center">
        <div class="card shadow border-0 rounded-3 p-5 bg-white">
            <div class="mb-4 text-danger">
                <i class="bi bi-x-circle-fill" style="font-size: 5rem;"></i>
            </div>
            <h1 class="text-danger fw-extrabold mb-3">System Error</h1>
            <h5 class="text-secondary mb-4">An error occurred while processing your request.</h5>
            
            @if (Model.ShowRequestId)
            {
                <div class="p-3 bg-light rounded border mb-4">
                    <span class="text-muted small d-block">REQUEST ID</span>
                    <code>@Model.RequestId</code>
                </div>
            }
            
            <p class="small text-secondary mb-4">
                The operations team has been notified. Please try again later or contact support.
            </p>
            <hr class="my-4" />
            <a href="/" class="btn btn-primary btn-gms-primary px-4 py-2">
                <i class="bi bi-house-door-fill me-2"></i> Return to Homepage
            </a>
        </div>
    </div>
</div>
