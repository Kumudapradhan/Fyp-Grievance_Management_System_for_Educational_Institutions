<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Grievance Management System</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts Inter -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GMS.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light navbar-custom">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shield-check-fill me-2 text-primary"></i> GMS<span>.Portal</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            if (User.IsInRole("Administrator"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Admin" asp-action="Index">
                                        <i class="bi bi-speedometer2 me-1"></i> Admin Console
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Report" asp-action="Index">
                                        <i class="bi bi-bar-chart-line me-1"></i> Analytics & Reports
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("Staff"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Staff" asp-action="Index">
                                        <i class="bi bi-journal-text me-1"></i> Department Queue
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("Student"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Grievance" asp-action="Index">
                                        <i class="bi bi-house-door me-1"></i> Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Grievance" asp-action="Submit">
                                        <i class="bi bi-plus-circle me-1"></i> Submit Grievance
                                    </a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Grievance" asp-action="Track">
                                    <i class="bi bi-search me-1"></i> Track Ticket
                                </a>
                            </li>
                        }
                    </ul>
                    
                    <div class="d-flex align-items-center">
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Student"))
                        {
                            @await RenderSectionAsync("StudentNotificationBell", required: false)
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown me-3">
                                <span class="text-secondary small me-2"><i class="bi bi-person-badge-fill me-1"></i> Role: <strong>@(User.IsInRole("Administrator") ? "Administrator" : User.IsInRole("Staff") ? "Staff" : "Student")</strong></span>
                                <span class="fw-semibold text-dark">@User.Identity.Name</span>
                            </div>
                            
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm fw-medium">
                                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm me-2 fw-medium">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Login
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm fw-medium">
                                <i class="bi bi-person-plus me-1"></i> Register
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container my-4">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="text-muted">
        <div class="container text-center">
            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Staff"))
            {
                <p class="mb-1">Grievance Management System — Department Officer Portal</p>
            }
            else
            {
                <p class="mb-1">&copy; @DateTime.UtcNow.Year - Grievance Management System (GMS)</p>
            }
            <p class="small text-secondary mb-0">Developed for Asia Pacific University (APU) Final Year Project | Student: Kumuda Pradhan | SDG 4 Alignment</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
