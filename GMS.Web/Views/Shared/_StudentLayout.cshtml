@using Microsoft.EntityFrameworkCore
@inject GMS.Web.Data.ApplicationDbContext _layoutDb
@inject Microsoft.AspNetCore.Identity.UserManager<GMS.Web.Models.Entities.ApplicationUser> _layoutUserMgr
@{
    Layout = "_Layout";

    var currentStudentId = _layoutUserMgr.GetUserId(User);
    var unreadStudentNotifications = new List<GMS.Web.Models.Entities.Notification>();
    var unreadStudentCount = 0;

    if (!string.IsNullOrEmpty(currentStudentId))
    {
        unreadStudentCount = _layoutDb.Notifications.Count(n => n.UserId == currentStudentId && !n.IsRead);
        
        unreadStudentNotifications = _layoutDb.Notifications
            .Include(n => n.Grievance)
            .Where(n => n.UserId == currentStudentId && !n.IsRead)
            .OrderByDescending(n => n.SentAt)
            .Take(5)
            .ToList();
    }
}

@section StudentNotificationBell {
    <div class="dropdown me-3">
        <button class="btn btn-link text-dark position-relative p-1" type="button" id="studentBellDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="text-decoration: none;">
            <i class="bi bi-bell-fill fs-5 text-primary"></i>
            @if (unreadStudentCount > 0)
            {
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">
                    @unreadStudentCount
                </span>
            }
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-2" aria-labelledby="studentBellDropdown" style="width: 320px; max-height: 400px; overflow-y: auto; font-size: 0.85rem;">
            <li class="dropdown-header fw-bold text-dark d-flex justify-content-between align-items-center border-bottom pb-2">
                <span>Notifications (@unreadStudentCount)</span>
                @if (unreadStudentCount > 0)
                {
                    <form asp-controller="Grievance" asp-action="MarkAllNotificationsRead" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link p-0 text-primary fw-semibold text-decoration-none small" style="font-size: 0.75rem;">Mark all as read</button>
                    </form>
                }
            </li>
            @if (unreadStudentNotifications.Any())
            {
                @foreach (var note in unreadStudentNotifications)
                {
                    <li>
                        <a class="dropdown-item py-2.5 border-bottom text-wrap text-dark" asp-controller="Grievance" asp-action="Detail" asp-route-id="@note.GrievanceId">
                            <div class="fw-semibold text-dark mb-0.5">@note.Grievance?.TicketNumber</div>
                            <div class="text-secondary small">@note.Message</div>
                            <div class="text-muted small mt-1 text-end" style="font-size: 0.7rem;">@note.SentAt.ToString("g")</div>
                        </a>
                    </li>
                }
            }
            else
            {
                <li class="text-center py-4 text-muted">
                    <i class="bi bi-bell-slash fs-4 d-block mb-1"></i>
                    No unread notifications
                </li>
            }
        </ul>
    </div>
}

<div class="row">
    <!-- Student Sidebar -->
    <div class="col-lg-3 mb-4">
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="card-title mb-0"><i class="bi bi-person-fill-gear me-2"></i> Student Hub</h5>
            </div>
            <div class="list-group list-group-flush">
                <a asp-controller="Grievance" asp-action="Index" class="list-group-item list-group-item-action py-3 border-0 d-flex align-items-center">
                    <i class="bi bi-grid-fill text-primary fs-5 me-3"></i>
                    <div>
                        <span class="d-block fw-semibold text-dark">My History</span>
                        <small class="text-muted">Track filed grievances</small>
                    </div>
                </a>
                <a asp-controller="Grievance" asp-action="Submit" class="list-group-item list-group-item-action py-3 border-0 d-flex align-items-center border-top">
                    <i class="bi bi-file-earmark-plus-fill text-success fs-5 me-3"></i>
                    <div>
                        <span class="d-block fw-semibold text-dark">File New Ticket</span>
                        <small class="text-muted">Submit a complaint</small>
                    </div>
                </a>
                <a asp-controller="Grievance" asp-action="Track" class="list-group-item list-group-item-action py-3 border-0 d-flex align-items-center border-top">
                    <i class="bi bi-search text-warning fs-5 me-3"></i>
                    <div>
                        <span class="d-block fw-semibold text-dark">Track Ticket</span>
                        <small class="text-muted">Search by code</small>
                    </div>
                </a>
            </div>
        </div>
    </div>
    
    <!-- Student Page Body -->
    <div class="col-lg-9">
        @RenderBody()
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
