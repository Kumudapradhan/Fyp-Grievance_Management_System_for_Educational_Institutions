@model GMS.Web.Models.ViewModels.ReportViewModel

@{
    ViewData["Title"] = "Analytics & Reports";
    Layout = "_AdminLayout";
}

<div class="card shadow-sm border-0 rounded-3 p-4 mb-4 bg-white">
    <h3 class="fw-bold mb-1 text-dark"><i class="bi bi-bar-chart-line-fill me-2 text-primary"></i> Analytical Intelligence Report</h3>
    <p class="text-secondary mb-0">Review system activity, resolution efficiency, and departmental complaint volumes.</p>
</div>

<!-- KPI Cards row -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="metric-card m-total">
            <span class="metric-title">Total Submitted</span>
            <span class="metric-value">@Model.TotalSubmitted</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card m-resolved">
            <span class="metric-title">Resolved Cases</span>
            <span class="metric-value">@Model.TotalResolved</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card m-overdue">
            <span class="metric-title">Overdue Breaches</span>
            <span class="metric-value text-danger">@Model.TotalOverdue</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="metric-card m-high">
            <span class="metric-title">High Priority Cases</span>
            <span class="metric-value text-purple" style="color: #8b5cf6;">@Model.TotalHighPriority</span>
        </div>
    </div>
</div>

<!-- Chart Containers Row 1 -->
<div class="row g-4 mb-4">
    <!-- Bar Chart: Department volumes -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 rounded-3 bg-white h-100">
            <div class="card-header bg-light py-3 d-flex align-items-center justify-content-between">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-bar-chart-fill me-2 text-primary"></i> Grievances by Department</h6>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center p-3" style="min-height: 320px;">
                @if (Model.GrievancesByDepartment.Any())
                {
                    <canvas id="departmentBarChart" style="max-height: 300px; width: 100%;"></canvas>
                }
                else
                {
                    <span class="text-muted small">No departmental data available.</span>
                }
            </div>
        </div>
    </div>

    <!-- Doughnut Chart: Status Breakdown -->
    <div class="col-lg-5">
        <div class="card shadow-sm border-0 rounded-3 bg-white h-100">
            <div class="card-header bg-light py-3">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-pie-chart-fill me-2 text-primary"></i> Split by Live Status</h6>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center p-3" style="min-height: 320px;">
                @if (Model.GrievancesByStatus.Any())
                {
                    <canvas id="statusDoughnutChart" style="max-height: 280px; width: 100%;"></canvas>
                }
                else
                {
                    <span class="text-muted small">No status logs exist yet.</span>
                }
            </div>
        </div>
    </div>
</div>

<!-- Chart Container Row 2 -->
<div class="row g-4 mb-4">
    <!-- Line Chart: Monthly Volume -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 rounded-3 bg-white h-100">
            <div class="card-header bg-light py-3">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-activity me-2 text-primary"></i> Grievance Volume Over Time (Last 6 Months)</h6>
            </div>
            <div class="card-body p-3" style="min-height: 300px;">
                @if (Model.MonthlyVolume.Any())
                {
                    <canvas id="volumeLineChart" style="max-height: 280px; width: 100%;"></canvas>
                }
                else
                {
                    <span class="text-muted small text-center d-block py-5">No historical grievance data available.</span>
                }
            </div>
        </div>
    </div>

    <!-- Horizontal Bar Chart: Average Resolution Time -->
    <div class="col-lg-5">
        <div class="card shadow-sm border-0 rounded-3 bg-white h-100">
            <div class="card-header bg-light py-3">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-clock me-2 text-primary"></i> Avg Resolution Speed (Days)</h6>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center p-3" style="min-height: 300px;">
                @if (Model.AvgResolutionByDept.Any())
                {
                    <canvas id="resolutionBarChart" style="max-height: 280px; width: 100%;"></canvas>
                }
                else
                {
                    <span class="text-muted small">No resolution history available.</span>
                }
            </div>
        </div>
    </div>
</div>

<!-- Table: Category breakdown -->
<div class="card shadow-sm border-0 rounded-3 bg-white">
    <div class="card-header bg-light py-3">
        <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-table me-2 text-primary"></i> Category Distribution breakdown</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-gms align-middle mb-0">
                <thead>
                    <tr>
                        <th>Category Name</th>
                        <th class="text-center">Ticket Count</th>
                        <th class="text-center">Percentage of Total</th>
                        <th>Distribution Metric</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.GrievancesByCategory.Any())
                    {
                        @foreach (var cat in Model.GrievancesByCategory)
                        {
                            var percentage = Model.TotalSubmitted > 0 ? Math.Round((cat.Value / Model.TotalSubmitted) * 100, 1) : 0;
                            <tr>
                                <td class="fw-bold text-dark">@cat.Label</td>
                                <td class="text-center">@cat.Value</td>
                                <td class="text-center fw-bold text-primary">@percentage%</td>
                                <td>
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar bg-primary" role="progressbar" style="width: @(percentage)%;" aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">No categories filed yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <script>
        $(document).ready(function () {
            // 1. Department Bar Chart
            @if (Model.GrievancesByDepartment.Any())
            {
                <text>
                var ctxDept = document.getElementById('departmentBarChart').getContext('2d');
                new Chart(ctxDept, {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(Json.Serialize(Model.GrievancesByDepartment.Select(d => d.Label))),
                        datasets: [{
                            label: 'Grievances Count',
                            data: @Html.Raw(Json.Serialize(Model.GrievancesByDepartment.Select(d => d.Value))),
                            backgroundColor: 'rgba(30, 64, 175, 0.75)',
                            borderColor: 'rgba(30, 64, 175, 1)',
                            borderWidth: 1.5,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { stepSize: 1 }
                            }
                        }
                    }
                });
                </text>
            }

            // 2. Status Doughnut Chart
            @if (Model.GrievancesByStatus.Any())
            {
                <text>
                var ctxStatus = document.getElementById('statusDoughnutChart').getContext('2d');
                new Chart(ctxStatus, {
                    type: 'doughnut',
                    data: {
                        labels: @Html.Raw(Json.Serialize(Model.GrievancesByStatus.Select(d => d.Label))),
                        datasets: [{
                            data: @Html.Raw(Json.Serialize(Model.GrievancesByStatus.Select(d => d.Value))),
                            backgroundColor: [
                                '#3b82f6', // Open - Blue
                                '#f59e0b', // InProgress - Amber
                                '#10b981'  // Resolved - Emerald
                            ],
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'bottom' }
                        }
                    }
                });
                </text>
            }

            // 3. Line Chart (Monthly Volume)
            @if (Model.MonthlyVolume.Any())
            {
                <text>
                var ctxVolume = document.getElementById('volumeLineChart').getContext('2d');
                new Chart(ctxVolume, {
                    type: 'line',
                    data: {
                        labels: @Html.Raw(Json.Serialize(Model.MonthlyVolume.Select(m => m.Label))),
                        datasets: [{
                            label: 'Total Submissions',
                            data: @Html.Raw(Json.Serialize(Model.MonthlyVolume.Select(m => m.Value))),
                            fill: true,
                            backgroundColor: 'rgba(59, 130, 246, 0.1)',
                            borderColor: 'rgba(59, 130, 246, 1)',
                            borderWidth: 2.5,
                            tension: 0.3,
                            pointBackgroundColor: 'rgba(30, 64, 175, 1)'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { stepSize: 1 }
                            }
                        }
                    }
                });
                </text>
            }

            // 4. Horizontal Bar Chart (Avg Resolution Speed)
            @if (Model.AvgResolutionByDept.Any())
            {
                <text>
                var ctxRes = document.getElementById('resolutionBarChart').getContext('2d');
                new Chart(ctxRes, {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(Json.Serialize(Model.AvgResolutionByDept.Select(r => r.Label))),
                        datasets: [{
                            label: 'Average Resolution (Days)',
                            data: @Html.Raw(Json.Serialize(Model.AvgResolutionByDept.Select(r => r.Value))),
                            backgroundColor: 'rgba(16, 185, 129, 0.75)',
                            borderColor: 'rgba(16, 185, 129, 1)',
                            borderWidth: 1.5,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            x: {
                                beginAtZero: true,
                                title: { display: true, text: 'Days' }
                            }
                        }
                    }
                });
                </text>
            }
        });
    </script>
}
