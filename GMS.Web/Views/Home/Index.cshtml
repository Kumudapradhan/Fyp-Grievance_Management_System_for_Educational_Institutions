@{
    ViewData["Title"] = "GMS — University Grievance Management System";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GMS — University Grievance Management System</title>
    <meta name="description" content="Submit, track, and manage student grievances securely and transparently. A modern platform built for your university community." />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --primary-light: #3b82f6;
            --primary-50: #eff6ff;
            --primary-100: #dbeafe;
            --dark: #0f172a;
            --slate-700: #334155;
            --slate-500: #64748b;
            --slate-300: #cbd5e1;
            --slate-100: #f1f5f9;
            --white: #ffffff;
            --success: #10b981;
            --font: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: var(--font); background: var(--white); color: var(--slate-700); overflow-x: hidden; }

        /* SHARED CONTAINER — every section uses this */
        .lp-container {
            width: 100%;
            max-width: 1100px;
            margin-left: auto;
            margin-right: auto;
            padding-left: 2.5rem;
            padding-right: 2.5rem;
        }

        /* NAVBAR */
        .lp-nav {
            position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
            background: rgba(255,255,255,0.85);
            backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(226,232,240,0.8);
            padding: 0.9rem 0;
            transition: box-shadow 0.3s ease;
        }
        .lp-nav.scrolled { box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
        .lp-nav .lp-container {
            display: flex; align-items: center; justify-content: space-between;
        }
        .lp-brand {
            display: flex; align-items: center; gap: 0.5rem;
            text-decoration: none; font-weight: 800; font-size: 1.2rem;
            color: var(--dark); letter-spacing: -0.03em;
        }
        .lp-brand-icon {
            width: 36px; height: 36px; background: var(--primary); border-radius: 10px;
            display: flex; align-items: center; justify-content: center; color: white; font-size: 1rem;
        }
        .lp-nav-links { display: flex; gap: 0.25rem; list-style: none; align-items: center; }
        .lp-nav-links a {
            padding: 0.45rem 0.9rem; border-radius: 8px; text-decoration: none;
            font-weight: 500; font-size: 0.925rem; color: var(--slate-700);
            transition: background 0.15s, color 0.15s;
        }
        .lp-nav-links a:hover { background: var(--slate-100); color: var(--dark); }
        .lp-nav-actions { display: flex; align-items: center; gap: 0.6rem; }
        .btn-ghost {
            padding: 0.45rem 1rem; border-radius: 8px; border: none; background: transparent;
            font-weight: 600; font-size: 0.9rem; color: var(--slate-700); cursor: pointer;
            text-decoration: none; transition: background 0.15s, color 0.15s;
        }
        .btn-ghost:hover { background: var(--slate-100); color: var(--dark); }
        .btn-primary-lp {
            padding: 0.5rem 1.1rem; border-radius: 8px; border: none; background: var(--primary);
            font-weight: 600; font-size: 0.9rem; color: white; cursor: pointer; text-decoration: none;
            transition: background 0.2s, transform 0.1s, box-shadow 0.2s;
            box-shadow: 0 2px 8px rgba(37,99,235,0.3);
        }
        .btn-primary-lp:hover { background: var(--primary-dark); color: white; transform: translateY(-1px); box-shadow: 0 4px 16px rgba(37,99,235,0.35); }

        /* HERO */
        .hero {
            min-height: 100vh; padding: 8rem 0 5rem;
            background: linear-gradient(160deg, #f8faff 0%, #eff6ff 45%, #f0fdf4 100%);
            display: flex; align-items: center; position: relative;
        }
        .hero::before {
            content: ''; position: absolute; width: 800px; height: 800px;
            background: radial-gradient(circle, rgba(37,99,235,0.06) 0%, transparent 70%);
            top: -200px; right: -200px; pointer-events: none;
        }
        .hero::after {
            content: ''; position: absolute; width: 600px; height: 600px;
            background: radial-gradient(circle, rgba(16,185,129,0.05) 0%, transparent 70%);
            bottom: -100px; left: -100px; pointer-events: none;
        }
        .hero .lp-container {
            display: grid; grid-template-columns: 1fr 1fr; gap: 3rem;
            align-items: center; position: relative; z-index: 1;
        }
        .hero-badge {
            display: inline-flex; align-items: center; gap: 0.5rem;
            background: rgba(37,99,235,0.08); color: var(--primary);
            border: 1px solid rgba(37,99,235,0.2); padding: 0.4rem 0.9rem;
            border-radius: 999px; font-size: 0.8rem; font-weight: 600; margin-bottom: 1.5rem;
        }
        .hero-title {
            font-size: clamp(2.5rem, 5vw, 3.75rem); font-weight: 900;
            line-height: 1.08; letter-spacing: -0.04em; color: var(--dark); margin-bottom: 1.25rem;
        }
        .hero-title .accent { color: var(--primary); position: relative; }
        .hero-title .accent::after {
            content: ''; position: absolute; bottom: -4px; left: 0; right: 0;
            height: 4px; background: linear-gradient(90deg, var(--primary), #60a5fa);
            border-radius: 999px; opacity: 0.5;
        }
        .hero-sub { font-size: 1.05rem; color: var(--slate-500); line-height: 1.7; margin-bottom: 2.25rem; max-width: 480px; }
        .hero-cta { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2.5rem; }
        .btn-hero-primary {
            display: inline-flex; align-items: center; gap: 0.5rem;
            padding: 0.85rem 1.6rem; background: var(--primary); color: white;
            font-weight: 700; font-size: 0.95rem; border-radius: 10px; text-decoration: none;
            border: none; cursor: pointer; box-shadow: 0 4px 16px rgba(37,99,235,0.35);
            transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
        }
        .btn-hero-primary:hover { background: var(--primary-dark); color: white; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(37,99,235,0.4); }
        .btn-hero-secondary {
            display: inline-flex; align-items: center; gap: 0.5rem;
            padding: 0.85rem 1.6rem; background: white; color: var(--dark);
            font-weight: 700; font-size: 0.95rem; border-radius: 10px; text-decoration: none;
            border: 1.5px solid var(--slate-300); cursor: pointer;
            transition: border-color 0.2s, background 0.2s, transform 0.15s;
        }
        .btn-hero-secondary:hover { border-color: var(--primary-light); color: var(--primary); background: var(--primary-50); transform: translateY(-2px); }
        .hero-trust { display: flex; gap: 1.5rem; flex-wrap: wrap; }
        .trust-item { display: flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; font-weight: 500; color: var(--slate-500); }
        .trust-item i { color: var(--success); font-size: 0.95rem; }

        /* Hero visual column: needs padding-right so stat badge doesn't clip */
        .hero-visual { position: relative; padding-right: 2rem; padding-bottom: 1rem; }
        .hero-img-wrapper {
            position: relative; border-radius: 20px; overflow: hidden;
            box-shadow: 0 24px 64px rgba(0,0,0,0.15); aspect-ratio: 4/3;
        }
        .hero-img-wrapper img { width: 100%; height: 100%; object-fit: cover; display: block; }

        /* Stat badge: floats outside image top-right (positioned on .hero-visual) */
        .hero-stat-badge {
            position: absolute; top: 1rem; right: -0.5rem; background: white;
            border-radius: 14px; padding: 0.8rem 1.1rem;
            box-shadow: 0 8px 32px rgba(0,0,0,0.14); text-align: center; min-width: 96px;
            z-index: 10;
        }
        .hero-stat-badge .sv { font-size: 1.55rem; font-weight: 900; color: var(--primary); letter-spacing: -0.04em; line-height: 1; }
        .hero-stat-badge .sl { font-size: 0.7rem; font-weight: 600; color: var(--slate-500); margin-top: 0.2rem; }

        /* Resolved badge: floats outside image bottom-left (positioned on .hero-visual) */
        .hero-resolved-badge {
            position: absolute; bottom: -0.5rem; left: -0.5rem; background: white;
            border-radius: 14px; padding: 0.7rem 0.9rem;
            box-shadow: 0 8px 32px rgba(0,0,0,0.14);
            display: flex; align-items: center; gap: 0.6rem;
            animation: float 3s ease-in-out infinite;
            z-index: 10;
        }
        .ri-wrap {
            width: 34px; height: 34px; border-radius: 50%; background: rgba(16,185,129,0.12);
            display: flex; align-items: center; justify-content: center; color: var(--success); font-size: 1rem;
            flex-shrink: 0;
        }
        .rt-title { font-size: 0.78rem; font-weight: 700; color: var(--dark); white-space: nowrap; }
        .rt-sub { font-size: 0.68rem; color: var(--slate-500); white-space: nowrap; }

        /* METRICS */
        .metrics-strip { background: white; border-top: 1px solid var(--slate-100); border-bottom: 1px solid var(--slate-100); padding: 2.5rem 0; }
        .metrics-strip .lp-container { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
        .metric-item { text-align: center; padding: 0.5rem; }
        .metric-item .mv { font-size: 2.1rem; font-weight: 900; color: var(--dark); letter-spacing: -0.04em; line-height: 1; }
        .metric-item .ml { font-size: 0.85rem; color: var(--slate-500); margin-top: 0.4rem; font-weight: 500; }

        /* FEATURES */
        .features-section { padding: 6rem 0; background: var(--slate-100); }
        .how-section { padding: 6rem 0; background: white; }
        .cta-section { padding: 6rem 0; background: var(--slate-100); }
        .section-eyebrow {
            display: inline-flex; align-items: center; gap: 0.4rem;
            font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
            color: var(--primary); background: var(--primary-50); border: 1px solid var(--primary-100);
            padding: 0.35rem 0.85rem; border-radius: 999px; margin-bottom: 1rem;
        }
        .section-title { font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 900; letter-spacing: -0.035em; color: var(--dark); margin-bottom: 1rem; line-height: 1.15; }
        .section-sub { font-size: 1rem; color: var(--slate-500); max-width: 520px; line-height: 1.7; }
        .section-header { text-align: center; margin-bottom: 3.5rem; }
        .section-header .section-sub { margin: 0 auto; }
        .features-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
        .feature-card {
            background: white; border: 1px solid var(--slate-300); border-radius: 16px; padding: 2rem;
            transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
            opacity: 0;
        }
        .feature-card.visible { opacity: 1; animation: fadeUp 0.5s ease both; }
        .feature-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(0,0,0,0.08); border-color: var(--primary-light); }
        .feature-icon {
            width: 52px; height: 52px; border-radius: 14px;
            display: flex; align-items: center; justify-content: center; font-size: 1.4rem;
            margin-bottom: 1.25rem; transition: transform 0.25s ease;
        }
        .feature-card:hover .feature-icon { transform: scale(1.08); }
        .fi-blue   { background: #eff6ff; color: #2563eb; }
        .fi-green  { background: #ecfdf5; color: #059669; }
        .fi-purple { background: #f5f3ff; color: #7c3aed; }
        .fi-amber  { background: #fffbeb; color: #d97706; }
        .fi-rose   { background: #fff1f2; color: #e11d48; }
        .fi-sky    { background: #f0f9ff; color: #0284c7; }
        .feature-card h3 { font-size: 1.05rem; font-weight: 700; color: var(--dark); margin-bottom: 0.6rem; }
        .feature-card p { font-size: 0.9rem; color: var(--slate-500); line-height: 1.65; }
        .feature-link { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.85rem; font-weight: 600; color: var(--primary); margin-top: 1rem; text-decoration: none; transition: gap 0.2s; }
        .feature-link:hover { gap: 0.6rem; color: var(--primary-dark); }

        /* HOW IT WORKS */
        .steps-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; position: relative; margin-top: 3.5rem; }
        .steps-grid::before {
            content: ''; position: absolute; top: 32px; left: 12.5%; right: 12.5%;
            height: 2px; background: linear-gradient(90deg, var(--primary-100) 0%, var(--primary) 50%, var(--primary-100) 100%);
        }
        .step-card { text-align: center; padding: 0 0.5rem; }
        .step-number {
            width: 64px; height: 64px; border-radius: 50%; background: var(--primary); color: white;
            font-size: 1.3rem; font-weight: 900; display: flex; align-items: center; justify-content: center;
            margin: 0 auto 1.5rem; position: relative; z-index: 1;
            box-shadow: 0 4px 20px rgba(37,99,235,0.35);
        }
        .step-card h3 { font-size: 1rem; font-weight: 700; color: var(--dark); margin-bottom: 0.5rem; }
        .step-card p { font-size: 0.875rem; color: var(--slate-500); line-height: 1.6; }

        /* CTA */
        .cta-card {
            background: linear-gradient(135deg, #1e40af 0%, #2563eb 50%, #3b82f6 100%);
            border-radius: 24px; padding: 4rem; text-align: center;
            position: relative; overflow: hidden;
        }
        .cta-card::before { content: ''; position: absolute; width: 400px; height: 400px; background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%); top: -100px; right: -50px; }
        .cta-card::after  { content: ''; position: absolute; width: 300px; height: 300px; background: radial-gradient(circle, rgba(255,255,255,0.06) 0%, transparent 70%); bottom: -80px; left: -30px; }
        .cta-card h2 { font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 900; color: white; letter-spacing: -0.04em; margin-bottom: 1rem; position: relative; z-index: 1; }
        .cta-card p  { font-size: 1rem; color: rgba(255,255,255,0.75); margin-bottom: 2.5rem; position: relative; z-index: 1; }
        .cta-buttons { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; position: relative; z-index: 1; }
        .btn-cta-white {
            padding: 0.85rem 2rem; background: white; color: var(--primary); font-weight: 700;
            font-size: 0.95rem; border-radius: 10px; border: none; text-decoration: none; cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s; box-shadow: 0 4px 16px rgba(0,0,0,0.15);
        }
        .btn-cta-white:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.2); color: var(--primary-dark); }
        .btn-cta-outline {
            padding: 0.85rem 2rem; background: transparent; color: white; font-weight: 700;
            font-size: 0.95rem; border-radius: 10px; border: 2px solid rgba(255,255,255,0.5);
            text-decoration: none; cursor: pointer; transition: border-color 0.2s, background 0.2s, transform 0.2s;
        }
        .btn-cta-outline:hover { border-color: white; background: rgba(255,255,255,0.1); color: white; transform: translateY(-2px); }

        /* FOOTER */
        .lp-footer { background: var(--dark); color: rgba(255,255,255,0.6); padding: 3rem 0 1.5rem; }
        .footer-top {
            display: flex; align-items: center; justify-content: space-between;
            padding-bottom: 2rem; border-bottom: 1px solid rgba(255,255,255,0.1);
            flex-wrap: wrap; gap: 1.5rem;
        }
        .footer-brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; }
        .footer-brand-icon { width: 36px; height: 36px; border-radius: 10px; background: var(--primary); display: flex; align-items: center; justify-content: center; color: white; font-size: 1rem; }
        .footer-brand-name { font-size: 1.1rem; font-weight: 800; color: white; letter-spacing: -0.03em; }
        .footer-brand-sub { font-size: 0.78rem; color: rgba(255,255,255,0.45); }
        .footer-links { display: flex; gap: 1.5rem; list-style: none; flex-wrap: wrap; }
        .footer-links a { color: rgba(255,255,255,0.55); text-decoration: none; font-size: 0.875rem; font-weight: 500; transition: color 0.15s; }
        .footer-links a:hover { color: white; }
        .footer-bottom { padding-top: 1.5rem; text-align: center; font-size: 0.8rem; color: rgba(255,255,255,0.35); }

        /* ANIMATIONS */
        @@keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
        @@keyframes fadeUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
        .anim-hero { animation: fadeUp 0.6s ease both; }
        .anim-hero-delay { animation: fadeUp 0.6s 0.2s ease both; }

        /* ── RESPONSIVE ── */

        /* Tablet landscape / small desktop */
        @@media (max-width: 1100px) {
            .hero .lp-container { grid-template-columns: 1fr 1fr; gap: 2rem; }
            .hero-title { font-size: clamp(2rem, 4.5vw, 3rem); }
        }

        /* Tablet portrait */
        @@media (max-width: 900px) {
            .hero { padding: 7rem 0 4rem; min-height: auto; }
            .hero .lp-container { grid-template-columns: 1fr; gap: 2.5rem; }
            .hero-visual { max-width: 540px; width: 100%; margin: 0 auto; }
            .hero-sub { max-width: 100%; }
            .steps-grid { grid-template-columns: repeat(2, 1fr); }
            .steps-grid::before { display: none; }
            .metrics-strip .lp-container { grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
            .features-section, .how-section, .cta-section { padding: 4rem 0; }
        }

        /* Mobile landscape / large phones */
        @@media (max-width: 640px) {
            .lp-nav-links { display: none; }
            .hero { padding: 6rem 0 3rem; }
            .hero-title { font-size: 2.4rem; }
            .features-grid { grid-template-columns: 1fr; }
            .cta-card { padding: 2.5rem 1.5rem; }
            .footer-top { flex-direction: column; align-items: flex-start; }
            .section-title { font-size: 1.75rem; }
        }

        /* Small phones */
        @@media (max-width: 420px) {
            .hero-title { font-size: 2rem; }
            .steps-grid { grid-template-columns: 1fr; }
            .metrics-strip .lp-container { grid-template-columns: repeat(2, 1fr); }
            .hero-cta { flex-direction: column; }
            .btn-hero-primary, .btn-hero-secondary { width: 100%; justify-content: center; }
        }
    </style>
</head>
<body>

<!-- NAVBAR -->
<nav class="lp-nav" id="mainNav">
    <div class="lp-container">
        <a class="lp-brand" asp-controller="Home" asp-action="Index">
            <div class="lp-brand-icon"><i class="bi bi-shield-check"></i></div>
            GMS
        </a>
        <ul class="lp-nav-links">
            <li><a href="#features">Features</a></li>
            <li><a href="#how-it-works">How it Works</a></li>
            <li><a href="#cta">About</a></li>
        </ul>
        <div class="lp-nav-actions">
            <a asp-controller="Account" asp-action="Login" class="btn-ghost">Login</a>
            <a asp-controller="Account" asp-action="Register" class="btn-primary-lp">Register</a>
        </div>
    </div>
</nav>

<!-- HERO -->
<section class="hero">
    <div class="lp-container">
        <div class="anim-hero">
            <div class="hero-badge">
                <i class="bi bi-mortarboard-fill"></i>
                University Grievance Management System
            </div>
            <h1 class="hero-title">
                Your Voice<br>
                <span class="accent">Matters.</span>
            </h1>
            <p class="hero-sub">
                Submit, track, and manage student grievances securely and transparently.
                A modern platform built for your university community.
            </p>
            <div class="hero-cta">
                <a asp-controller="Grievance" asp-action="Submit" class="btn-hero-primary">
                    Submit Complaint <i class="bi bi-arrow-right"></i>
                </a>
                <a href="#features" class="btn-hero-secondary">
                    Learn More <i class="bi bi-chevron-down"></i>
                </a>
            </div>
            <div class="hero-trust">
                <span class="trust-item"><i class="bi bi-check-circle-fill"></i> Free for students</span>
                <span class="trust-item"><i class="bi bi-check-circle-fill"></i> Anonymous option</span>
                <span class="trust-item"><i class="bi bi-check-circle-fill"></i> 24/7 access</span>
            </div>
        </div>
        <div class="hero-visual anim-hero-delay">
            <div class="hero-img-wrapper">
                <img src="~/images/students_library.png" alt="Students collaborating in university library" />
            </div>
            <!-- Badges float outside the image frame -->
            <div class="hero-stat-badge">
                <div class="sv">98%</div>
                <div class="sl">Resolution rate</div>
            </div>
            <div class="hero-resolved-badge">
                <div class="ri-wrap"><i class="bi bi-check-circle-fill"></i></div>
                <div>
                    <div class="rt-title">Complaint Resolved</div>
                    <div class="rt-sub">GMS-2024-003 &bull; Just now</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- METRICS STRIP -->
<div class="metrics-strip">
    <div class="lp-container">
        <div class="metric-item">
            <div class="mv">+58%</div>
            <div class="ml">Filing rate increase</div>
        </div>
        <div class="metric-item">
            <div class="mv">-45%</div>
            <div class="ml">Faster resolution time</div>
        </div>
        <div class="metric-item">
            <div class="mv">+34%</div>
            <div class="ml">Routing accuracy</div>
        </div>
        <div class="metric-item">
            <div class="mv">98%</div>
            <div class="ml">Student satisfaction</div>
        </div>
    </div>
</div>

<!-- FEATURES -->
<section class="features-section" id="features">
    <div class="lp-container">
        <div class="section-header">
            <span class="section-eyebrow"><i class="bi bi-stars"></i> Platform Features</span>
            <h2 class="section-title">Everything you need</h2>
            <p class="section-sub">A complete platform for managing university grievances with <span style="color:var(--primary);font-weight:600">transparency and efficiency.</span></p>
        </div>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon fi-blue"><i class="bi bi-file-earmark-text"></i></div>
                <h3>Online Submission</h3>
                <p>Submit grievances anytime, anywhere through our secure digital platform with file attachment support.</p>
