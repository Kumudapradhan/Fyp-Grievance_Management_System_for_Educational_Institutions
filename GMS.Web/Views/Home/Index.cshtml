@{
    ViewData["Title"] = "Welcome";
}

<div class="row align-items-center py-5">
    <div class="col-lg-6 mb-5 mb-lg-0">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-semibold mb-3">
            <i class="bi bi-mortarboard-fill me-2"></i> Education Portal Project
        </span>
        <h1 class="display-4 fw-extrabold text-dark mb-4" style="line-height: 1.1; letter-spacing: -0.02em;">
            Student Grievance Management System
        </h1>
        <p class="lead text-secondary mb-4">
            A transparent, modern, digitalized platform for submitting, tracking, and resolving institutional complaints. Built to support quality learning environments and ensure student voice representation.
        </p>
        
        <div class="d-flex flex-wrap gap-3 mb-5">
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg px-4 py-3 fw-bold shadow-sm">
                <i class="bi bi-person-plus-fill me-2"></i> Register Account
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-dark btn-lg px-4 py-3 fw-bold">
                <i class="bi bi-box-arrow-in-right me-2"></i> Access Portal
            </a>
        </div>
        
        <!-- SDG Alignment Banner -->
        <div class="d-flex align-items-center p-3 bg-success bg-opacity-10 border border-success border-opacity-25 rounded-3">
            <i class="bi bi-globe-americas text-success fs-3 me-3"></i>
            <div>
                <h6 class="text-success fw-bold mb-0">Aligned with UN SDG Goal 4: Quality Education</h6>
                <small class="text-secondary">Enabling equitable, accessible, and transparent communication lines for all students.</small>
            </div>
        </div>
    </div>
    
    <div class="col-lg-6">
        <!-- Anonymous Ticket Tracker card -->
        <div class="card shadow border-0 rounded-3 p-4 mb-4 bg-white">
            <h4 class="fw-bold mb-3 text-dark"><i class="bi bi-search text-primary me-2"></i> Anonymous Ticket Tracking</h4>
            <p class="text-secondary small">Did you submit a complaint anonymously? Enter your unique ticket reference code below to review status logs without signing in.</p>
            <form asp-controller="Grievance" asp-action="Track" method="get">
                <div class="input-group">
                    <input type="text" name="ticketNumber" class="form-control form-control-lg form-control-gms" placeholder="e.g. GMS-2026-00001" required />
                    <button type="submit" class="btn btn-dark btn-lg px-4">
                        <i class="bi bi-search"></i> Find
                    </button>
                </div>
            </form>
        </div>

        <!-- Academic justification card -->
        <div class="card shadow-sm border-0 rounded-3 p-4 bg-white">
            <h5 class="fw-bold mb-3 text-secondary"><i class="bi bi-file-earmark-bar-graph me-2"></i> Literature Research Metrics</h5>
            <div class="row text-center g-3">
                <div class="col-6 col-sm-4">
                    <div class="p-2 border rounded bg-light">
                        <h4 class="text-primary fw-extrabold mb-0">+58%</h4>
                        <small class="text-muted d-block" style="font-size: 0.75rem;">Filing Rate Increase (Alifat et al., 2022)</small>
                    </div>
                </div>
                <div class="col-6 col-sm-4">
                    <div class="p-2 border rounded bg-light">
                        <h4 class="text-success fw-extrabold mb-0">-45%</h4>
                        <small class="text-muted d-block" style="font-size: 0.75rem;">Resolution Time (Mukhtar et al., 2021)</small>
                    </div>
                </div>
                <div class="col-12 col-sm-4">
                    <div class="p-2 border rounded bg-light">
                        <h4 class="text-warning fw-extrabold mb-0">+34%</h4>
                        <small class="text-muted d-block" style="font-size: 0.75rem;">Routing Accuracy (Anusiuba et al., 2021)</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
