{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=GMS_Db;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "SLA": {
    "OverdueDays": 7,
    "RepetitiveWindowDays": 30,
    "RepetitiveThresholdCount": 3
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUser": "gms.notifications@gmail.com",
    "SmtpPass": "YOUR_APP_PASSWORD",
    "FromAddress": "gms.notifications@gmail.com",
    "FromName": "GMS Notifications",
    "UseFileMock": true,
    "FileMockPath": "wwwroot/sent_emails"
  },
  "FileUpload": {
    "MaxFileSizeMB": 5,
    "AllowedExtensions": [ ".pdf", ".jpg", ".jpeg", ".png", ".docx" ]
  }
}
